---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<style>
  .footer { background: #111; color: #ccc; margin-top: 48px; }
  .footer-main { padding: 32px 16px; display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 24px; max-width: 1280px; margin: 0 auto; }
  .footer-col h4 { color: #fff; font-size: 14px; font-weight: 700; margin-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px; }
  .footer-col a { display: block; font-size: 14px; color: #aaa; margin-bottom: 8px; }
  .footer-col a:hover { color: #e8450a; }
  .footer-bottom { border-top: 1px solid #333; padding: 16px; text-align: center; font-size: 12px; color: #666; max-width: 1280px; margin: 0 auto; }
  .footer-bottom a { color: #888; margin: 0 6px; }
  .footer-bottom a:hover { color: #e8450a; }
  @media (max-width: 768px) {
    .footer-main { grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .footer { margin-bottom: 68px; }
  }
</style>

<footer class="footer">
  <div class="footer-main">
    <div class="footer-col">
      <h4>Buy</h4>
      <a href={`${base}/`}>Home</a>
      <a href={`${base}/search`}>Search</a>
      <a href={`${base}/cart`}>Cart</a>
      <a href={`${base}/orders`}>My Orders</a>
    </div>
    <div class="footer-col">
      <h4>Sell</h4>
      <a href={`${base}/seller/new-product`}>List a Product</a>
      <a href={`${base}/seller/dashboard`}>Seller Dashboard</a>
    </div>
    <div class="footer-col">
      <h4>Account</h4>
      <a href={`${base}/auth/signin`}>Sign In</a>
      <a href={`${base}/auth/register`}>Register</a>
    </div>
    <div class="footer-col">
      <h4>Help</h4>
      <a href="#contact">Contact Us</a>
      <a href="#how">How it Works</a>
      <a href="#whatsapp">WhatsApp Support</a>
    </div>
  </div>
  <div class="footer-bottom">
    <a href="#privacy">Privacy</a>
    <a href="#terms">Terms</a>
    <a href="#sitemap">Site Map</a>
    <br><br>
    &copy; {new Date().getFullYear()} Kebay Kenya — All rights reserved
  </div>
</footer>
