---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="List a Product — Kebay">
  <Header />
  <main>
    <div class="container" style="padding-top:20px;padding-bottom:48px;max-width:600px;">
      <h1 style="font-size:22px;font-weight:800;margin-bottom:4px;">➕ List a Product</h1>
      <p style="color:#666;font-size:14px;margin-bottom:24px;">Fill in the details. Buyers will contact you on WhatsApp.</p>

      <div id="errorMsg" class="alert alert-error" style="display:none;"></div>
      <div id="successMsg" class="alert alert-success" style="display:none;"></div>

      <form id="productForm" style="background:#fff;border:1px solid #e5e5e5;border-radius:16px;padding:24px;">

        <div class="form-group">
          <label class="form-label">📦 Product Title</label>
          <input class="form-input" type="text" id="title" placeholder="e.g. Samsung Galaxy A55 5G 128GB" required />
        </div>

        <div class="form-group">
          <label class="form-label">📂 Category</label>
          <select class="form-select" id="category" required>
            <option value="">Select category...</option>
            <option value="phones">📱 Phones</option>
            <option value="computers">💻 Computers</option>
            <option value="electronics">⚡ Electronics</option>
            <option value="fashion">👗 Fashion</option>
            <option value="home">🏠 Home & Garden</option>
            <option value="motors">🚗 Motors</option>
            <option value="sporting">⚽ Sporting Goods</option>
            <option value="toys">🎮 Toys & Hobbies</option>
            <option value="collectibles">🎨 Collectibles & Art</option>
          </select>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <div class="form-group">
            <label class="form-label">💰 Price (KSh)</label>
            <input class="form-input" type="number" id="price" placeholder="e.g. 45000" required min="1" />
          </div>
          <div class="form-group">
            <label class="form-label">🏷️ Original Price (KSh)</label>
            <input class="form-input" type="number" id="originalPrice" placeholder="Optional — for discount" min="1" />
          </div>
        </div>

        <div class="form-group">
          <label class="form-label">📦 Stock Quantity</label>
          <input class="form-input" type="number" id="stock" placeholder="How many do you have?" required min="1" value="1" />
        </div>

        <!-- Description + AI button -->
        <div class="form-group">
          <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
            <label class="form-label" style="margin-bottom:0;">📝 Description</label>
            <button type="button" id="generateDescBtn"
              style="display:flex;align-items:center;gap:5px;padding:7px 14px;background:#e8450a;color:#fff;border:none;border-radius:50px;font-size:13px;font-weight:700;cursor:pointer;">
              ✨ Generate Description
            </button>
          </div>
          <textarea class="form-textarea" id="description" placeholder="Describe your product — condition, size, what's included..." required style="min-height:120px;"></textarea>
        </div>

        <!-- Image Upload Zone -->
        <div class="form-group">
          <label class="form-label">🖼️ Product Photos</label>

          <!-- URL option (always available) -->
          <div style="margin-bottom:10px;">
            <input id="imageUrl" type="url" class="form-input" placeholder="Paste image URL (e.g. https://...jpg) — optional if uploading a file" />
            <div style="font-size:12px;color:#888;margin-top:4px;">Enter a direct image URL, or drag/drop a file below.</div>
          </div>

          <div id="uploadZone" style="border:2px dashed #e8450a;border-radius:12px;padding:32px;text-align:center;cursor:pointer;background:#fff9f7;transition:all 0.2s;">
            <div style="font-size:36px;margin-bottom:8px;">📷</div>
            <div style="font-weight:700;color:#e8450a;margin-bottom:4px;">Drop photos here or click to browse</div>
            <div style="font-size:13px;color:#888;">JPG, PNG, WEBP · Max 5MB each · Up to 5 images</div>
            <input type="file" id="imageInput" accept="image/*" multiple style="display:none;" />
          </div>
          <div id="uploadProgress" style="display:none;font-size:13px;color:#666;margin-top:8px;"></div>
          <div id="imagePreviewGrid" style="display:grid;grid-template-columns:repeat(5,1fr);gap:8px;margin-top:12px;"></div>
        </div>

        <!-- AI Photo Enhancement -->
        <div class="form-group" id="enhancePanel" style="display:none;">
          <label class="form-label">🎨 Enhance Photos</label>
          <div style="display:flex;gap:6px;flex-wrap:wrap;">
            <button type="button" class="filter-btn active" data-filter="none"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e8450a;background:#e8450a;color:#fff;font-size:12px;font-weight:700;cursor:pointer;">
              Original
            </button>
            <button type="button" class="filter-btn" data-filter="brightness(120%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              ☀️ Bright
            </button>
            <button type="button" class="filter-btn" data-filter="contrast(130%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              🔆 Contrast
            </button>
            <button type="button" class="filter-btn" data-filter="saturate(150%) contrast(110%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              🌈 Vivid
            </button>
            <button type="button" class="filter-btn" data-filter="sepia(20%) saturate(120%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              🌅 Warm
            </button>
            <button type="button" class="filter-btn" data-filter="hue-rotate(180deg) saturate(80%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              🧊 Cool
            </button>
            <button type="button" class="filter-btn" data-filter="contrast(110%) brightness(105%)"
              style="padding:6px 12px;border-radius:50px;border:1.5px solid #e5e5e5;background:#f5f5f5;font-size:12px;font-weight:600;cursor:pointer;">
              ✨ Sharp
            </button>
          </div>
          <div style="font-size:12px;color:#888;margin-top:6px;">Filter is applied visually — original file is kept for upload.</div>
        </div>

        <!-- WhatsApp field (shown/hidden based on profile) -->
        <div class="form-group" id="waField">
          <label class="form-label">📲 Your WhatsApp Number (required)</label>
          <input class="form-input" type="tel" id="whatsapp" placeholder="e.g. 0712345678" />
          <div style="font-size:12px;color:#888;margin-top:4px;">Buyers will be sent to this number when they click Buy.</div>
        </div>
        <div id="waSavedBadge" style="display:none;padding:10px 14px;background:#f0fff4;border:1px solid #c6f6d5;border-radius:10px;margin-bottom:16px;align-items:center;gap:10px;">
          <span style="font-size:16px;">📲</span>
          <span id="waSavedText" style="font-weight:700;font-size:14px;flex:1;"></span>
          <button type="button" id="editWaBtn" style="padding:6px 12px;border-radius:8px;background:#fff;border:1px solid #c6f6d5;font-size:13px;font-weight:600;cursor:pointer;">Edit</button>
        </div>

        <!-- Preview -->
        <div id="preview" style="display:none;border:1px solid #e5e5e5;border-radius:12px;padding:14px;margin-bottom:16px;background:#f9f9f9;">
          <div style="font-size:13px;font-weight:700;margin-bottom:10px;color:#888;">PREVIEW</div>
          <div style="display:flex;gap:12px;align-items:flex-start;">
            <img id="previewImg" src="" alt="" style="width:80px;height:80px;object-fit:cover;border-radius:8px;background:#eee;" />
            <div>
              <div id="previewTitle" style="font-weight:700;font-size:14px;"></div>
              <div id="previewPrice" style="font-size:16px;font-weight:800;color:#e8450a;margin-top:4px;"></div>
              <div id="previewCat" style="font-size:12px;color:#888;margin-top:2px;"></div>
            </div>
          </div>
        </div>

        <button type="button" id="previewBtn"
          style="width:100%;padding:12px;border-radius:50px;background:#f5f5f5;border:none;font-size:14px;font-weight:600;cursor:pointer;margin-bottom:10px;">
          👁️ Preview
        </button>

        <button type="submit" id="submitBtn" class="btn btn-primary btn-full" style="border-radius:50px;font-size:16px;">
          🚀 Publish Listing
        </button>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  function ksh(n: number) { return `KSh ${n.toLocaleString('en-KE')}`; }

  // ── State ──
  let selectedFiles: File[] = [];
  let activeFilter = 'none';
  let savedWaNumber = '';

  // ── WhatsApp: check profile on load ──
  (async () => {
    await supabase.auth.getSession();
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;

    const { data: profile } = await supabase.from('profiles').select('whatsapp_number').eq('id', user.id).single();
    if (profile?.whatsapp_number) {
      savedWaNumber = profile.whatsapp_number;
      const waField = document.getElementById('waField')!;
      const badge = document.getElementById('waSavedBadge')!;
      const badgeText = document.getElementById('waSavedText')!;
      waField.style.display = 'none';
      badge.style.display = 'flex';
      badgeText.textContent = `WhatsApp: +${savedWaNumber}`;
    }
  })();

  document.getElementById('editWaBtn')?.addEventListener('click', () => {
    const waField = document.getElementById('waField')!;
    const badge = document.getElementById('waSavedBadge')!;
    waField.style.display = 'block';
    badge.style.display = 'none';
    const inp = document.getElementById('whatsapp') as HTMLInputElement;
    if (savedWaNumber) inp.value = savedWaNumber;
    inp.focus();
  });

  // ── Image upload zone ──
  const uploadZone = document.getElementById('uploadZone')!;
  const imageInput = document.getElementById('imageInput') as HTMLInputElement;

  uploadZone.addEventListener('click', () => imageInput.click());

  uploadZone.addEventListener('dragover', (e) => {
    e.preventDefault();
    uploadZone.style.background = '#fff0eb';
    uploadZone.style.borderColor = '#c23a08';
  });

  uploadZone.addEventListener('dragleave', () => {
    uploadZone.style.background = '#fff9f7';
    uploadZone.style.borderColor = '#e8450a';
  });

  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.style.background = '#fff9f7';
    uploadZone.style.borderColor = '#e8450a';
    const files = Array.from(e.dataTransfer?.files || []);
    addFiles(files);
  });

  imageInput.addEventListener('change', () => {
    addFiles(Array.from(imageInput.files || []));
    imageInput.value = '';
  });

  function addFiles(files: File[]) {
    const errorEl = document.getElementById('errorMsg')!;
    for (const file of files) {
      if (selectedFiles.length >= 5) {
        errorEl.textContent = 'Maximum 5 images allowed.';
        errorEl.style.display = 'block';
        break;
      }
      if (!file.type.startsWith('image/')) {
        errorEl.textContent = `"${file.name}" is not an image file.`;
        errorEl.style.display = 'block';
        continue;
      }
      if (file.size > 5 * 1024 * 1024) {
        errorEl.textContent = `"${file.name}" exceeds 5MB limit.`;
        errorEl.style.display = 'block';
        continue;
      }
      errorEl.style.display = 'none';
      selectedFiles.push(file);
    }
    renderPreviews();
  }

  function renderPreviews() {
    const grid = document.getElementById('imagePreviewGrid')!;
    const enhancePanel = document.getElementById('enhancePanel')!;

    if (selectedFiles.length === 0) {
      grid.innerHTML = '';
      enhancePanel.style.display = 'none';
      return;
    }

    enhancePanel.style.display = 'block';

    grid.innerHTML = selectedFiles.map((file, i) => {
      const url = URL.createObjectURL(file);
      const filterStyle = activeFilter !== 'none' ? `filter:${activeFilter};` : '';
      return `
        <div style="position:relative;border-radius:8px;overflow:hidden;aspect-ratio:1;background:#f5f5f5;">
          <img src="${url}" data-idx="${i}" style="width:100%;height:100%;object-fit:cover;${filterStyle}" />
          <button type="button" onclick="window._removeImg(${i})"
            style="position:absolute;top:3px;right:3px;width:22px;height:22px;border-radius:50%;background:rgba(0,0,0,0.6);color:#fff;border:none;cursor:pointer;font-size:12px;line-height:1;display:flex;align-items:center;justify-content:center;">✕</button>
          <div class="removebg-wrap" style="position:absolute;bottom:3px;left:3px;right:3px;">
            <button type="button" onclick="window._removeBg(${i})"
              style="width:100%;padding:3px;background:rgba(0,0,0,0.6);color:#fff;border:none;border-radius:4px;font-size:10px;cursor:pointer;font-weight:600;">
              ✂️ Remove BG
            </button>
          </div>
        </div>`;
    }).join('');
  }

  (window as any)._removeImg = (idx: number) => {
    selectedFiles.splice(idx, 1);
    renderPreviews();
  };

  // ── Remove.bg integration ──
  const REMOVE_BG_KEY = (import.meta.env.PUBLIC_REMOVE_BG_KEY) || '';

  (window as any)._removeBg = async (idx: number) => {
    if (!REMOVE_BG_KEY) {
      const errorEl = document.getElementById('errorMsg')!;
      errorEl.textContent = 'Add REMOVE_BG_API_KEY to .env to enable background removal.';
      errorEl.style.display = 'block';
      return;
    }

    const grid = document.getElementById('imagePreviewGrid')!;
    const imgEl = grid.querySelectorAll('img')[idx] as HTMLImageElement;
    if (imgEl) imgEl.style.opacity = '0.5';

    try {
      const formData = new FormData();
      formData.append('image_file', selectedFiles[idx]);
      formData.append('size', 'auto');

      const res = await fetch('https://api.remove.bg/v1.0/removebg', {
        method: 'POST',
        headers: { 'X-Api-Key': REMOVE_BG_KEY },
        body: formData,
      });

      if (!res.ok) throw new Error(`remove.bg: ${res.statusText}`);

      const blob = await res.blob();
      const newFile = new File([blob], selectedFiles[idx].name.replace(/\.[^.]+$/, '.png'), { type: 'image/png' });
      selectedFiles[idx] = newFile;
      renderPreviews();
    } catch (err: any) {
      if (imgEl) imgEl.style.opacity = '1';
      const errorEl = document.getElementById('errorMsg')!;
      errorEl.textContent = `Background removal failed: ${err.message}`;
      errorEl.style.display = 'block';
    }
  };

  // ── Filter buttons ──
  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => {
        (b as HTMLElement).style.background = '#f5f5f5';
        (b as HTMLElement).style.color = '#333';
        (b as HTMLElement).style.borderColor = '#e5e5e5';
      });
      (btn as HTMLElement).style.background = '#e8450a';
      (btn as HTMLElement).style.color = '#fff';
      (btn as HTMLElement).style.borderColor = '#e8450a';

      activeFilter = (btn as HTMLElement).dataset.filter || 'none';
      // Apply filter to all preview images
      document.querySelectorAll('#imagePreviewGrid img').forEach(img => {
        (img as HTMLImageElement).style.filter = activeFilter !== 'none' ? activeFilter : '';
      });
    });
  });

  // ── AI Description Generator ──
  document.getElementById('generateDescBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('generateDescBtn') as HTMLButtonElement;
    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const category = (document.getElementById('category') as HTMLSelectElement).value;
    const errorEl = document.getElementById('errorMsg')!;

    if (!title) {
      errorEl.textContent = 'Please enter a product title first.';
      errorEl.style.display = 'block';
      return;
    }
    errorEl.style.display = 'none';

    btn.textContent = '✨ Generating…';
    btn.disabled = true;

    const descTextarea = document.getElementById('description') as HTMLTextAreaElement;

    // 8-second timeout
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);

    try {
      const res = await fetch('https://api-inference.huggingface.co/models/mistralai/Mistral-7B-Instruct-v0.2', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        signal: controller.signal,
        body: JSON.stringify({
          inputs: `[INST]Write a short product listing description for a Kenyan online marketplace. Product: "${title}". Category: ${category || 'general'}. Keep it under 80 words. Mention key features, condition if relevant, and why a Kenyan buyer should buy it. No prices. Be direct and honest.[/INST]`,
          parameters: { max_new_tokens: 150, temperature: 0.7 },
        }),
      });
      clearTimeout(timeout);

      if (!res.ok) throw new Error('API error');

      const data = await res.json();
      let text = '';
      if (Array.isArray(data) && data[0]?.generated_text) {
        text = data[0].generated_text;
      } else if (data?.generated_text) {
        text = data.generated_text;
      }
      // Strip [INST] tags if echoed back
      text = text.replace(/\[INST\].*?\[\/INST\]/gs, '').trim();
      if (text) {
        descTextarea.value = text;
      } else {
        throw new Error('Empty response');
      }
    } catch (_) {
      clearTimeout(timeout);
      // Fallback template
      descTextarea.value = `${title} - Quality ${category || 'product'} available in Kenya. Good condition and ready for delivery. Contact seller on WhatsApp to confirm availability, arrange viewing, and discuss delivery options.`;
    }

    btn.textContent = '✨ Generate Description';
    btn.disabled = false;
  });

  // ── Preview ──
  document.getElementById('previewBtn')?.addEventListener('click', () => {
    const title = (document.getElementById('title') as HTMLInputElement).value;
    const price = (document.getElementById('price') as HTMLInputElement).value;
    const cat = (document.getElementById('category') as HTMLSelectElement).value;

    const preview = document.getElementById('preview')!;
    if (title || price) {
      (document.getElementById('previewTitle') as HTMLElement).textContent = title || 'No title yet';
      (document.getElementById('previewPrice') as HTMLElement).textContent = price ? ksh(parseInt(price)) : '';
      (document.getElementById('previewCat') as HTMLElement).textContent = cat || '';

      // Show first selected image in preview (file upload or URL)
      const previewImg = document.getElementById('previewImg') as HTMLImageElement;
      const urlInput = (document.getElementById('imageUrl') as HTMLInputElement)?.value.trim();
      if (selectedFiles.length > 0) {
        previewImg.src = URL.createObjectURL(selectedFiles[0]);
        if (activeFilter !== 'none') previewImg.style.filter = activeFilter;
      } else if (urlInput) {
        previewImg.src = urlInput;
      }
      preview.style.display = 'block';
    }
  });

  // ── Form submit ──
  document.getElementById('productForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn') as HTMLButtonElement;
    const errorEl = document.getElementById('errorMsg')!;
    const successEl = document.getElementById('successMsg')!;

    btn.textContent = 'Publishing...';
    btn.disabled = true;
    errorEl.style.display = 'none';

    await supabase.auth.getSession();
    const { data: { user } } = await supabase.auth.getUser();

    const title = (document.getElementById('title') as HTMLInputElement).value.trim();
    const category = (document.getElementById('category') as HTMLSelectElement).value;
    const price = parseInt((document.getElementById('price') as HTMLInputElement).value);
    const originalPrice = parseInt((document.getElementById('originalPrice') as HTMLInputElement).value) || null;
    const stock = parseInt((document.getElementById('stock') as HTMLInputElement).value);
    const description = (document.getElementById('description') as HTMLTextAreaElement).value.trim();
    const whatsappInput = (document.getElementById('whatsapp') as HTMLInputElement).value.trim().replace(/\s+/g, '');
    const whatsapp = whatsappInput || savedWaNumber;

    if (!user) {
      localStorage.setItem('kebay_draft_product', JSON.stringify({ title, category, price, originalPrice, stock, description, whatsapp }));
      window.location.href = (window as any).BASE_URL + '/auth/register?role=seller&redirect=/seller/new-product';
      return;
    }

    // ── Upload images ──
    let images: string[] = [];
    if (selectedFiles.length > 0) {
      const progressEl = document.getElementById('uploadProgress')!;
      progressEl.style.display = 'block';

      for (let i = 0; i < selectedFiles.length; i++) {
        const file = selectedFiles[i];
        progressEl.textContent = `Uploading image ${i + 1}/${selectedFiles.length}…`;

        const path = `${user.id}/${Date.now()}_${file.name}`;
        const { error: uploadError } = await supabase.storage
          .from('product-images')
          .upload(path, file);

        if (uploadError) {
          // Fallback: use object URL (warns seller)
          console.warn('Storage upload failed, using local URL:', uploadError.message);
          images.push(URL.createObjectURL(file));
          progressEl.textContent = `⚠️ Image ${i + 1} uploaded locally (won't persist after page reload)`;
        } else {
          const { data: urlData } = supabase.storage.from('product-images').getPublicUrl(path);
          images.push(urlData.publicUrl);
        }
      }
      progressEl.style.display = 'none';
    }

    if (images.length === 0) {
      // Try the URL input field
      const urlInput = (document.getElementById('imageUrl') as HTMLInputElement)?.value.trim();
      if (urlInput) {
        images = [urlInput];
      } else {
        images = ['https://picsum.photos/seed/product/600/600'];
      }
    }

    const { data, error } = await supabase.from('products').insert({
      seller_id: user.id,
      title, category, price,
      description, images, stock,
      is_active: true,
      original_price: originalPrice,
    }).select().single();

    if (error) {
      console.error('Product insert error:', error);
      errorEl.textContent = `Error: ${error.message} (code: ${error.code})`;
      errorEl.style.display = 'block';
      btn.textContent = '🚀 Publish Listing';
      btn.disabled = false;
      return;
    }

    // Save WhatsApp to profile if visible/changed
    if (whatsapp) {
      const { error: waErr } = await supabase.from('profiles').update({ whatsapp_number: whatsapp }).eq('id', user.id);
      if (waErr) console.warn('WhatsApp update warning:', waErr.message);
    }

    successEl.innerHTML = `
      ✅ Product listed! Product ID: <strong>${data.id}</strong><br>
      <a href="${(window as any).BASE_URL || ''}/product/${data.id}" style="color:#1a7a4a;font-weight:700;">View listing →</a>
    `;
    successEl.style.display = 'block';
    btn.textContent = '✅ Published!';
    setTimeout(() => { window.location.href = (window as any).BASE_URL + '/seller/dashboard'; }, 2000);
  });
</script>
