---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const q     = Astro.url.searchParams.get('q')     || '';
const cat   = Astro.url.searchParams.get('cat')   || '';
const deals = Astro.url.searchParams.get('deals') || '';
const base  = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout title="Search — Kebay">
  <Header />

  <main>
    <div class="container" style="padding-top:16px;padding-bottom:48px;">

      <!-- Deals banner — shown when ?deals=true -->
      <div id="dealsBanner" style="display:none;background:linear-gradient(135deg,#e8450a,#c23a08);color:#fff;border-radius:16px;padding:20px 24px;margin-bottom:20px;align-items:center;gap:16px;">
        <div style="font-size:36px;">🏷️</div>
        <div>
          <div style="font-size:11px;font-weight:700;letter-spacing:2px;text-transform:uppercase;opacity:.8;margin-bottom:4px;">LIMITED TIME</div>
          <div style="font-size:22px;font-weight:900;line-height:1.2;">Today's Best Deals</div>
          <div style="font-size:13px;opacity:.85;margin-top:4px;">Products with the biggest discounts in Kenya</div>
        </div>
        <div style="margin-left:auto;font-size:48px;opacity:.15;">💰</div>
      </div>

      <!-- Results header -->
      <div style="margin-bottom:14px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;">
        <div style="display:flex;align-items:center;gap:10px;">
          <h1 id="resultsTitle" style="font-size:18px;font-weight:700;">All Products</h1>
          <span id="dealsBadge" style="display:none;background:#fee2e2;color:#dc2626;font-size:11px;font-weight:700;padding:3px 10px;border-radius:50px;">🔥 Deals</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px;">
          <p id="resultsCount" style="font-size:13px;color:#666;"></p>
          <select id="sortSelect" style="padding:8px 12px;border:1.5px solid #e5e5e5;border-radius:8px;font-size:13px;background:#fff;outline:none;cursor:pointer;">
            <option value="default">Sort: Default</option>
            <option value="discount_desc">Biggest Discount</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
            <option value="name_asc">Name: A–Z</option>
          </select>
        </div>
      </div>

      <div style="display:flex;gap:20px;align-items:flex-start;">

        <!-- Sidebar filters (desktop) -->
        <aside id="sidebar" style="width:200px;flex-shrink:0;" class="desktop-only">
          <div class="card" style="padding:16px;margin-bottom:12px;">
            <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;">Category</h3>
            <div id="catSidebar"></div>
          </div>
          <div class="card" style="padding:16px;">
            <h3 style="font-size:14px;font-weight:700;margin-bottom:12px;">Price Range (KSh)</h3>
            <input id="minPrice" class="form-input" type="number" placeholder="Min" style="margin-bottom:8px;font-size:13px;padding:8px 10px;" />
            <input id="maxPrice" class="form-input" type="number" placeholder="Max" style="margin-bottom:10px;font-size:13px;padding:8px 10px;" />
            <button id="applyPrice" class="btn btn-primary btn-sm btn-full" style="border-radius:8px;">Apply</button>
            <button id="clearFilters" style="width:100%;margin-top:6px;padding:7px;border-radius:8px;border:1px solid #e5e5e5;background:#f5f5f5;font-size:13px;cursor:pointer;">Clear filters</button>
          </div>
        </aside>

        <!-- Product area -->
        <div style="flex:1;min-width:0;">

          <!-- Mobile category pills -->
          <div id="catPills" class="scroll-row mobile-only" style="margin-bottom:14px;"></div>

          <!-- Product grid -->
          <div id="productGrid" class="grid-4" style="gap:12px;"></div>

          <!-- Empty state -->
          <div id="emptyState" style="display:none;text-align:center;padding:60px 20px;color:#888;">
            <div style="font-size:48px;margin-bottom:12px;">🔍</div>
            <div style="font-size:18px;font-weight:700;color:#333;margin-bottom:8px;">No products found</div>
            <p>Try a different search or category</p>
            <button id="clearBtn" style="margin-top:16px;padding:12px 28px;background:#e8450a;color:#fff;border:none;border-radius:50px;font-weight:700;font-size:14px;cursor:pointer;">Clear filters</button>
          </div>

        </div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  @media (max-width: 768px) {
    #productGrid { grid-template-columns: repeat(2, 1fr) !important; }
  }
</style>

<script define:vars={{ initialQ: q, initialCat: cat, initialDeals: deals, BASE_URL: base }}>
  window.__kebayInitQ     = initialQ;
  window.__kebayInitCat   = initialCat;
  window.__kebayInitDeals = initialDeals;
  window.BASE_URL         = BASE_URL;
</script>

<script>
  import { supabase } from '../lib/supabase';
  import { watchTable } from '../lib/realtime';
  import { DEMO_PRODUCTS } from '../lib/demoData';

  const B = (window as any).BASE_URL || '';
  const params0 = new URLSearchParams(location.search);
  const initialQ     = (window as any).__kebayInitQ     || params0.get('q')     || '';
  const initialCat   = (window as any).__kebayInitCat   || params0.get('cat')   || '';
  const initialDeals = (window as any).__kebayInitDeals || params0.get('deals') || '';

  const ALL_PRODUCTS_DEMO = DEMO_PRODUCTS.map(p => ({
    id: p.id, title: p.title, price: p.price,
    original_price: p.original, image: p.images[0],
    category: p.category, seller: p.seller.name,
  }));

  const CATEGORIES = [
    { name:'All',         slug:'',            icon:'' },
    { name:'Phones',      slug:'phones',      icon:'📱' },
    { name:'Computers',   slug:'computers',   icon:'💻' },
    { name:'Electronics', slug:'electronics', icon:'⚡' },
    { name:'Fashion',     slug:'fashion',     icon:'👗' },
    { name:'Home',        slug:'home',        icon:'🏠' },
    { name:'Motors',      slug:'motors',      icon:'🚗' },
    { name:'Sports',      slug:'sporting',    icon:'⚽' },
    { name:'Gaming',      slug:'gaming',      icon:'🎮' },
  ];

  function ksh(n: number) { return `KSh ${n.toLocaleString('en-KE')}`; }

  let ALL_PRODUCTS: any[] = ALL_PRODUCTS_DEMO;

  let state = {
    q:     initialQ,
    cat:   initialCat,
    deals: initialDeals === 'true',
    min:   '',
    max:   '',
    sort:  initialDeals === 'true' ? 'discount_desc' : 'default',
  };

  function applyDealsUI() {
    const banner = document.getElementById('dealsBanner');
    const badge  = document.getElementById('dealsBadge');
    if (state.deals) {
      if (banner) banner.style.display = 'flex';
      if (badge) badge.style.display = 'inline-block';
    } else {
      if (banner) banner.style.display = 'none';
      if (badge) badge.style.display = 'none';
    }
  }

  async function loadProducts() {
    try {
      const { data, error } = await supabase
        .from('products')
        .select('*, profiles!seller_id(full_name, whatsapp_number)')
        .eq('is_active', true)
        .order('created_at', { ascending: false });

      if (!error && data && data.length > 0) {
        const realProducts = data.map((p: any) => ({
          ...p,
          image: p.images?.[0] || 'https://picsum.photos/seed/product/400/400',
          seller: p.profiles?.full_name || 'Seller',
        }));
        // Merge real products first, then demo products not already represented
        const demoFill = ALL_PRODUCTS_DEMO.filter(d => !realProducts.some((r: any) => r.id === d.id));
        ALL_PRODUCTS = [...realProducts, ...demoFill];
      } else {
        ALL_PRODUCTS = ALL_PRODUCTS_DEMO;
      }
    } catch (_) {
      ALL_PRODUCTS = ALL_PRODUCTS_DEMO;
    }
    render();
  }

  function renderCats() {
    const sidebar = document.getElementById('catSidebar');
    const pills   = document.getElementById('catPills');
    if (!sidebar || !pills) return;
    sidebar.innerHTML = CATEGORIES.map(c => `
      <button onclick="setCat('${c.slug}')"
        style="display:block;width:100%;text-align:left;padding:7px 10px;border-radius:8px;font-size:14px;margin-bottom:2px;border:none;cursor:pointer;background:${state.cat===c.slug?'#fff0eb':'transparent'};color:${state.cat===c.slug?'#e8450a':'#333'};font-weight:${state.cat===c.slug?'700':'400'};">
        ${c.icon} ${c.name}
      </button>`).join('');
    pills.innerHTML = CATEGORIES.map(c => `
      <button onclick="setCat('${c.slug}')"
        style="display:inline-block;padding:7px 16px;border-radius:50px;font-size:13px;font-weight:600;white-space:nowrap;flex-shrink:0;border:none;cursor:pointer;background:${state.cat===c.slug?'#e8450a':'#f0f0f0'};color:${state.cat===c.slug?'#fff':'#333'};">
        ${c.icon} ${c.name||'All'}
      </button>`).join('');
  }

  function getResults() {
    let r = [...ALL_PRODUCTS];
    if (state.q)   r = r.filter(p => p.title.toLowerCase().includes(state.q.toLowerCase()) || (p.seller||'').toLowerCase().includes(state.q.toLowerCase()));
    if (state.cat) r = r.filter(p => p.category === state.cat);
    if (state.deals) r = r.filter(p => { const orig = p.original_price ?? 0; return orig > p.price; });
    if (state.min) r = r.filter(p => p.price >= parseInt(state.min));
    if (state.max) r = r.filter(p => p.price <= parseInt(state.max));
    if (state.sort === 'price_asc')      r.sort((a,b) => a.price - b.price);
    if (state.sort === 'price_desc')     r.sort((a,b) => b.price - a.price);
    if (state.sort === 'name_asc')       r.sort((a,b) => a.title.localeCompare(b.title));
    if (state.sort === 'discount_desc') {
      r.sort((a, b) => {
        const origA = a.original_price ?? a.price;
        const origB = b.original_price ?? b.price;
        const pctA  = origA > 0 ? (origA - a.price) / origA : 0;
        const pctB  = origB > 0 ? (origB - b.price) / origB : 0;
        return pctB - pctA;
      });
    }
    return r;
  }

  function render() {
    const results = getResults();
    const grid  = document.getElementById('productGrid')!;
    const empty = document.getElementById('emptyState')!;
    const title = document.getElementById('resultsTitle')!;
    const count = document.getElementById('resultsCount')!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    applyDealsUI();

    if (state.deals && !state.q && !state.cat) title.textContent = "Today's Deals";
    else if (state.q)   title.textContent = `Results for "${state.q}"`;
    else if (state.cat) title.textContent = CATEGORIES.find(c=>c.slug===state.cat)?.name || state.cat;
    else                title.textContent = 'All Products';
    count.textContent = `${results.length} listing${results.length!==1?'s':''} found`;

    // Set correct sort select
    (document.getElementById('sortSelect') as HTMLSelectElement).value = state.sort;

    if (results.length === 0) { grid.innerHTML = ''; empty.style.display = 'block'; }
    else {
      empty.style.display = 'none';
      grid.innerHTML = results.map(p => {
        const orig = p.original_price ?? 0;
        const hasDiscount = orig > p.price;
        const pct = hasDiscount ? Math.round((1 - p.price / orig) * 100) : 0;
        return `
          <a href="${B}/product/${p.id}" class="product-card">
            <img src="${p.image || 'https://picsum.photos/seed/product/400/400'}" alt="${p.title}" class="product-card__img" loading="lazy" />
            ${hasDiscount ? `<div class="product-card__badge">${pct}% OFF</div>` : ''}
            <button class="product-card__wish" onclick="event.preventDefault()">🤍</button>
            <div class="product-card__body">
              <div class="product-card__title">${p.title}</div>
              <div style="margin-top:4px;">
                <span class="product-card__price">${ksh(p.price)}</span>
                ${hasDiscount ? `<span class="product-card__original">${ksh(orig)}</span>` : ''}
              </div>
              <div style="font-size:11px;color:#888;margin-top:3px;">by ${p.seller||'Seller'}</div>
            </div>
          </a>`;
      }).join('');
      if (!reduced) {
        Array.from(grid.children).forEach((el, i) => {
          const e = el as HTMLElement;
          e.style.opacity = '0'; e.style.transform = 'translateY(8px)';
          e.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
          setTimeout(() => { e.style.opacity = '1'; e.style.transform = 'translateY(0)'; }, i * 30);
        });
      }
    }
    renderCats();
    const p = new URLSearchParams();
    if (state.q)     p.set('q',     state.q);
    if (state.cat)   p.set('cat',   state.cat);
    if (state.deals) p.set('deals', 'true');
    if (state.min)   p.set('min',   state.min);
    if (state.max)   p.set('max',   state.max);
    history.replaceState(null, '', `${B}/search` + (p.toString() ? '?' + p.toString() : ''));
  }

  (window as any).setCat = (slug: string) => { state.cat = slug; state.deals = false; render(); };

  document.getElementById('applyPrice')?.addEventListener('click', () => {
    state.min = (document.getElementById('minPrice') as HTMLInputElement).value;
    state.max = (document.getElementById('maxPrice') as HTMLInputElement).value;
    render();
  });
  document.getElementById('sortSelect')?.addEventListener('change', (e) => {
    state.sort = (e.target as HTMLSelectElement).value;
    render();
  });
  function clearAll() {
    state = { q:'', cat:'', deals:false, min:'', max:'', sort:'default' };
    (document.getElementById('minPrice') as HTMLInputElement).value = '';
    (document.getElementById('maxPrice') as HTMLInputElement).value = '';
    (document.getElementById('sortSelect') as HTMLSelectElement).value = 'default';
    render();
  }
  document.getElementById('clearFilters')?.addEventListener('click', clearAll);
  document.getElementById('clearBtn')?.addEventListener('click', clearAll);

  document.querySelectorAll(`form[action="${B}/search"]`).forEach(form => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const input = (form as HTMLFormElement).querySelector('input[name="q"]') as HTMLInputElement;
      if (input) { state.q = input.value.trim(); state.deals = false; render(); }
    });
  });

  loadProducts();
  const searchChannel = watchTable(supabase, 'products', async () => { await loadProducts(); });
  window.addEventListener('beforeunload', () => searchChannel.unsubscribe());
</script>
