  // ── TAB 2: ANALYTICS ──
  const dayNames=['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
  function getDemoChartData(n){
    const labels=[],oc=[],rc=[];
    for(let i=n-1;i>=0;i--){
      const d=new Date(Date.now()-i*86400000);
      labels.push(n<=7?dayNames[d.getDay()]:(d.getMonth()+1)+'/'+(d.getDate()));
      oc.push(Math.floor(Math.random()*80)+20);
      rc.push(Math.floor(Math.random()*50000)+10000);
    }
    return{labels,oc,rc};
  }
  function renderBarChart(elId,data,maxV,cls){
    const el=document.getElementById(elId);
    const step=Math.ceil(data.length/7);
    const sam=data.filter((_,i)=>i%step===0).slice(0,7);
    el.innerHTML=sam.map(d=>`<div class="bar-col"><div class="bar-col-bar ${cls}" style="height:${Math.round((d.v/maxV)*100)}px"></div><div class="bar-col-label">${esc(d.l)}</div></div>`).join('');
  }
  function loadAnalytics(n){
    const{labels,oc,rc}=getDemoChartData(n);
    const maxO=Math.max(...oc),maxR=Math.max(...rc);
    renderBarChart('ordersChart',labels.map((l,i)=>({l,v:oc[i]})),maxO,'');
    renderBarChart('revenueChart',labels.map((l,i)=>({l,v:rc[i]})),maxR,'green');
    document.getElementById('topProductsBody').innerHTML=DEMO.products.slice(0,5).map((p,i)=>`
      <tr><td><strong>#${i+1}</strong></td><td>${esc(p.title)}</td><td>${esc(p.category)}</td>
      <td>${Math.floor(Math.random()*200)+50}</td><td>KSh ${(p.price*(Math.floor(Math.random()*200)+50)).toLocaleString('en-KE')}</td></tr>`).join('');
    const tu=DEMO.stats.users,s=DEMO.stats.sellers,b=tu-s;
    document.getElementById('userGrowth').innerHTML=`
      <div class="progress-label"><span>Buyers</span><span>${b}</span></div>
      <div class="progress-track"><div class="progress-fill buyers" style="width:${Math.round((b/tu)*100)}%"></div></div>
      <div class="progress-label"><span>Sellers</span><span>${s}</span></div>
      <div class="progress-track"><div class="progress-fill sellers" style="width:${Math.round((s/tu)*100)}%"></div></div>`;
  }
  document.querySelectorAll('.date-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.date-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      loadAnalytics(parseInt(btn.dataset.days));
    });
  });

  // ── TAB 3: PRODUCTS ──
  let allProducts=[],productPage=1;
  const PAGE_SIZE=20;
  async function loadProducts(){
    allProducts=[...DEMO.products];
    try{
      const r=await dbFetch('/rest/v1/products?select=id,title,price,stock,is_active,category,seller:profiles!seller_id(full_name)&order=created_at.desc');
      if(Array.isArray(r)&&r.length)allProducts=r.map(p=>({...p,seller:p.seller?.full_name||'—'}));
    }catch(e){}
    const cats=[...new Set(allProducts.map(p=>p.category).filter(Boolean))];
    const sel=document.getElementById('productCatFilter');
    sel.innerHTML='<option value="">All Categories</option>'+cats.map(c=>`<option value="${esc(c)}">${esc(c)}</option>`).join('');
    renderProducts();
  }
  function getFilteredProds(){
    const q=document.getElementById('productSearch').value.toLowerCase();
    const cat=document.getElementById('productCatFilter').value;
    const st=document.getElementById('productStatusFilter').value;
    return allProducts.filter(p=>{
      if(q&&!p.title?.toLowerCase().includes(q))return false;
      if(cat&&p.category!==cat)return false;
      if(st==='active'&&!p.is_active)return false;
      if(st==='inactive'&&p.is_active)return false;
      return true;
    });
  }
  function renderProducts(){
    const f=getFilteredProds(),tot=f.length,pages=Math.ceil(tot/PAGE_SIZE)||1;
    if(productPage>pages)productPage=pages;
    const sl=f.slice((productPage-1)*PAGE_SIZE,productPage*PAGE_SIZE);
    document.getElementById('productPageInfo').textContent=`Page ${productPage} of ${pages} (${tot} products)`;
    document.getElementById('productsBody').innerHTML=sl.map(p=>{
      const imgId=(p.id||'prod').replace(/[^a-z0-9]/gi,'').slice(0,10)||'prod';
      return`<tr>
        <td><img src="https://picsum.photos/seed/${esc(imgId)}/48/48" width="48" height="48" style="border-radius:6px;display:block;object-fit:cover" alt=""></td>
        <td style="font-weight:600">${esc(p.title)}</td>
        <td>${esc(p.seller||'—')}</td><td>${esc(p.category||'—')}</td>
        <td>KSh ${(p.price||0).toLocaleString('en-KE')}</td><td>${p.stock??'—'}</td>
        <td><span class="status-badge status-${p.is_active?'active':'inactive'}">${p.is_active?'Active':'Inactive'}</span></td>
        <td style="white-space:nowrap">
          <a href="/product/${esc(p.id)}" target="_blank" class="btn-icon">View</a>
          <button class="btn-icon" onclick="toggleProduct('${esc(p.id)}',${!p.is_active})">${p.is_active?'Deactivate':'Activate'}</button>
          <button class="btn-danger" onclick="deleteProduct('${esc(p.id)}')">Delete</button>
        </td>
      </tr>`;
    }).join('');
  }
  document.getElementById('productSearch').addEventListener('input',()=>{productPage=1;renderProducts();});
  document.getElementById('productCatFilter').addEventListener('change',()=>{productPage=1;renderProducts();});
  document.getElementById('productStatusFilter').addEventListener('change',()=>{productPage=1;renderProducts();});
  document.getElementById('productPrev').addEventListener('click',()=>{if(productPage>1){productPage--;renderProducts();}});
  document.getElementById('productNext').addEventListener('click',()=>{const p=Math.ceil(getFilteredProds().length/PAGE_SIZE)||1;if(productPage<p){productPage++;renderProducts();}});
  window.toggleProduct=async(id,ns)=>{
    try{await dbFetch('/rest/v1/products?id=eq.'+id,{method:'PATCH',body:JSON.stringify({is_active:ns})});}catch(e){}
    const p=allProducts.find(p=>p.id===id);if(p)p.is_active=ns;renderProducts();
  };
  window.deleteProduct=async(id)=>{
    if(!confirm('Delete this product?'))return;
    try{await dbFetch('/rest/v1/products?id=eq.'+id,{method:'DELETE'});}catch(e){}
    allProducts=allProducts.filter(p=>p.id!==id);renderProducts();
  };

  // ── TAB 4: USERS ──
  let allUsers=[];
  async function loadUsers(){
    allUsers=[...DEMO.users];
    try{
      const r=await dbFetch('/rest/v1/profiles?select=id,full_name,role,whatsapp_number,created_at&order=created_at.desc');
