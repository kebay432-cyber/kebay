  });
  window.editCategory=async(id)=>{
    const c=allCategories.find(c=>c.id===id);if(!c)return;
    const nn=prompt('Category name:',c.name);if(!nn)return;
    const ni=prompt('Category icon (emoji):',c.icon||'');
    try{await dbFetch('/rest/v1/categories?id=eq.'+id,{method:'PATCH',body:JSON.stringify({name:nn,icon:ni})});}catch(e){}
    c.name=nn;c.icon=ni||c.icon;renderCategories();
  };
  window.deleteCategory=async(id)=>{
    if(!confirm('Delete this category?'))return;
    try{await dbFetch('/rest/v1/categories?id=eq.'+id,{method:'DELETE'});}catch(e){}
    allCategories=allCategories.filter(c=>c.id!==id);renderCategories();
  };

  // ── TAB 8: SETTINGS ──
  async function loadSettings(){
    let s={site_name:'Kebay',tagline:'Shop smarter in Kenya',contact_email:'hello@kebay.com',support_whatsapp:'+254700000000',primary_color:'#e8450a',whatsapp_template:'Hi {seller_name}, I am interested in {product_name}.',maintenance_mode:'false'};
    try{const r=await dbFetch('/rest/v1/settings?select=key,value');if(Array.isArray(r))r.forEach(row=>{s[row.key]=row.value;});}catch(e){}
    Object.entries(s).forEach(([k,v])=>{const el=document.getElementById('set_'+k);if(!el)return;if(el.type==='checkbox')el.checked=v==='true';else el.value=v||'';});
    document.querySelectorAll('#primarySwatches .color-swatch').forEach(sw=>sw.classList.toggle('selected',sw.dataset.color===s.primary_color));
  }
  async function saveSetting(key,value){
    try{await dbFetch('/rest/v1/settings',{method:'POST',headers:{'Prefer':'resolution=merge-duplicates,return=minimal'},body:JSON.stringify({key,value})});}catch(e){}
  }
  document.querySelectorAll('[data-save-section]').forEach(btn=>{
    btn.addEventListener('click',async()=>{
      const sec=btn.dataset.saveSection;
      const pairs=[];
      if(sec==='general'){['site_name','tagline','contact_email','support_whatsapp'].forEach(k=>{const el=document.getElementById('set_'+k);if(el)pairs.push([k,el.value]);});}
      else if(sec==='appearance'){const el=document.getElementById('set_primary_color');if(el)pairs.push(['primary_color',el.value]);}
      else if(sec==='whatsapp'){pairs.push(['whatsapp_template',document.getElementById('set_whatsapp_template').value]);}
      else if(sec==='maintenance'){pairs.push(['maintenance_mode',document.getElementById('set_maintenance_mode').checked?'true':'false']);}
      await Promise.all(pairs.map(([k,v])=>saveSetting(k,v)));
      btn.textContent='✓ Saved!';btn.style.background='#1a7a4a';
      setTimeout(()=>{btn.textContent=btn.dataset.saveSection==='general'?'Save General Settings':btn.dataset.saveSection==='appearance'?'Save Appearance':btn.dataset.saveSection==='whatsapp'?'Save Template':'Save';btn.style.background='';},2000);
    });
  });
  document.querySelectorAll('#primarySwatches .color-swatch').forEach(s=>{
    s.addEventListener('click',()=>{document.querySelectorAll('#primarySwatches .color-swatch').forEach(x=>x.classList.remove('selected'));s.classList.add('selected');document.getElementById('set_primary_color').value=s.dataset.color;});
  });

  // ── INIT ──
  loadOverview();
  loadAnalytics(7);
  loadProducts();
  loadUsers();
  loadOrders();
  loadBanners();
  loadCategories();
  loadSettings();

  // ── REALTIME — use supabaseUrl/supabaseKey already set above, no second client ──
  (async () => {
    try {
      if (!supabaseUrl || !supabaseKey) return;

      // Build a lightweight client using the fetch-based Supabase REST+Realtime
      // We reuse the same credentials — just call supabase directly via the
      // already-imported module approach used by the rest of the admin page.
      // The admin page cannot import from src/lib/supabase.ts (standalone HTML)
      // so we use the ESM CDN version — same project, same key, NOT a new session.
      const { createClient } = await import('https://esm.sh/@supabase/supabase-js@2');
      const sb = createClient(supabaseUrl, supabaseKey, { auth: { persistSession: false } });

      const liveDot  = document.getElementById('adminLiveDot');
      const liveText = document.getElementById('adminLiveText');
      const setLive  = (on) => {
        if (liveDot)  liveDot.style.background   = on ? '#22c55e' : '#cbd5e1';
        if (liveText) { liveText.textContent = on ? '● Live' : 'Offline'; liveText.style.color = on ? '#16a34a' : '#94a3b8'; }
      };

      const overviewChannel = sb.channel('admin-overview')
        .on('postgres_changes', { event: '*', schema: 'public', table: 'products' }, () => { loadOverview(); loadProducts(); })
        .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' },   () => { loadOverview(); loadOrders(); })
        .on('postgres_changes', { event: '*', schema: 'public', table: 'profiles' }, () => { loadOverview(); loadUsers(); })
        .subscribe((status) => setLive(status === 'SUBSCRIBED'));

      window.addEventListener('beforeunload', () => { overviewChannel.unsubscribe(); });
    } catch (e) { console.warn('Admin realtime:', e); }
  })();

  // ── TOAST SYSTEM (inline since admin doesn't use Layout.astro) ──
  window.showToast = (message, type = 'info', duration = 3000) => {
    const container = document.getElementById('adminToastContainer');
    if (!container) return;
    const colors = { info:'#3b82f6', success:'#1a7a4a', warning:'#e8450a', error:'#e53e3e' };
    const toast = document.createElement('div');
    toast.style.cssText = `padding:12px 16px;border-radius:10px;background:${colors[type]||colors.info};color:#fff;font-size:14px;font-weight:600;box-shadow:0 4px 12px rgba(0,0,0,.15);opacity:0;transform:translateY(8px);transition:all 0.25s ease;max-width:300px;`;
    toast.textContent = message;
    container.appendChild(toast);
    requestAnimationFrame(() => { toast.style.opacity = '1'; toast.style.transform = 'translateY(0)'; });
    setTimeout(() => {
      toast.style.opacity = '0'; toast.style.transform = 'translateY(8px)';
      setTimeout(() => toast.remove(), 300);
    }, duration);
  };
</script>

<!-- Toast container for admin -->
<div id="adminToastContainer" style="position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:8px;"></div>

</body>
</html>
</html>
