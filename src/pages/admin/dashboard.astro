  document.getElementById('userSearch').addEventListener('input',renderUsers);
  document.getElementById('userRoleFilter').addEventListener('change',renderUsers);
  window.changeRole=async(id,role)=>{
    try{await dbFetch('/rest/v1/profiles?id=eq.'+id,{method:'PATCH',body:JSON.stringify({role})});}catch(e){}
    const u=allUsers.find(u=>u.id===id);if(u)u.role=role;renderUsers();
  };
  window.suspendUser=(id)=>{if(!confirm('Suspend this user?'))return;allUsers=allUsers.filter(u=>u.id!==id);renderUsers();};

  // ── TAB 5: ORDERS ──
  let allOrders=[],activeOrderStatus='all',expandedOrderId=null;
  async function loadOrders(){
    allOrders=DEMO.orders.map(o=>({id:o.id,product_name:o.product,buyer_name:o.buyer,seller_name:o.seller,quantity:o.qty,total:o.total,status:o.status,created_at:o.created_at}));
    try{
      const r=await dbFetch('/rest/v1/orders?select=id,status,quantity,created_at,products(title,price),buyer:profiles!buyer_id(full_name),seller:profiles!seller_id(full_name)&order=created_at.desc');
      if(Array.isArray(r)&&r.length)allOrders=r.map(o=>({id:o.id,product_name:o.products?.title||'—',buyer_name:o.buyer?.full_name||'—',seller_name:o.seller?.full_name||'—',quantity:o.quantity,total:(o.products?.price||0)*(o.quantity||1),status:o.status,created_at:o.created_at}));
    }catch(e){}
    renderOrders();
  }
  function renderOrders(){
    const f=activeOrderStatus==='all'?allOrders:allOrders.filter(o=>o.status===activeOrderStatus);
    document.getElementById('ordersBody').innerHTML=f.map(o=>{
      const short=String(o.id).slice(0,8).toUpperCase();
      const dt=o.created_at?new Date(o.created_at).toLocaleDateString('en-KE'):'—';
      const ex=expandedOrderId===o.id;
      return`<tr class="${ex?'expanded-row':''}" style="cursor:pointer" onclick="toggleOrderRow('${esc(o.id)}')">
        <td><input type="checkbox" class="order-check" data-id="${esc(o.id)}" onclick="event.stopPropagation()"></td>
        <td style="font-family:monospace;font-weight:600">${esc(short)}</td>
        <td>${esc(o.product_name)}</td><td>${esc(o.buyer_name)}</td><td>${esc(o.seller_name)}</td>
        <td>${esc(o.quantity)}</td><td style="font-weight:600">KSh ${(o.total||0).toLocaleString('en-KE')}</td>
        <td><span class="status-badge status-${esc(o.status)}">${esc(o.status)}</span></td>
        <td>${esc(dt)}</td>
      </tr>
      ${ex?`<tr class="expanded-row"><td colspan="9"><dl class="order-detail-panel">
        <div><dt>Order ID</dt><dd>${esc(o.id)}</dd></div>
        <div><dt>Product</dt><dd>${esc(o.product_name)}</dd></div>
        <div><dt>Buyer</dt><dd>${esc(o.buyer_name)}</dd></div>
        <div><dt>Total</dt><dd>KSh ${(o.total||0).toLocaleString('en-KE')}</dd></div>
      </dl></td></tr>`:''}`;
    }).join('');
    document.querySelectorAll('.order-check').forEach(cb=>cb.addEventListener('change',updateSelectedCount));
  }
  window.toggleOrderRow=(id)=>{expandedOrderId=expandedOrderId===id?null:id;renderOrders();};
  function updateSelectedCount(){document.getElementById('selectedCount').textContent=document.querySelectorAll('.order-check:checked').length+' selected';}
  document.getElementById('selectAllOrders').addEventListener('change',e=>{document.querySelectorAll('.order-check').forEach(cb=>{cb.checked=e.target.checked;});updateSelectedCount();});
  document.querySelectorAll('.order-tab-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{document.querySelectorAll('.order-tab-btn').forEach(b=>b.classList.remove('active'));btn.classList.add('active');activeOrderStatus=btn.dataset.status;renderOrders();});
  });
  document.getElementById('applyBulk').addEventListener('click',async()=>{
    const ns=document.getElementById('bulkStatus').value;
    if(!ns){alert('Select a status first.');return;}
    const ids=[...document.querySelectorAll('.order-check:checked')].map(cb=>cb.dataset.id);
    if(!ids.length){alert('Select at least one order.');return;}
    if(!confirm(`Change ${ids.length} order(s) to "${ns}"?`))return;
    try{await Promise.all(ids.map(id=>dbFetch('/rest/v1/orders?id=eq.'+id,{method:'PATCH',body:JSON.stringify({status:ns})})));}catch(e){}
    ids.forEach(id=>{const o=allOrders.find(o=>o.id===id);if(o)o.status=ns;});renderOrders();
  });

  // ── TAB 6: BANNERS ──
  let allBanners=[],dragSrc=null;
  async function loadBanners(){
    allBanners=[...DEMO.banners];
    try{const r=await dbFetch('/rest/v1/banners?order=sort_order.asc');if(Array.isArray(r)&&r.length)allBanners=r;}catch(e){}
    renderBanners();
  }
  function renderBanners(){
    const grid=document.getElementById('bannersGrid');
    if(!allBanners.length){grid.innerHTML='<div style="color:#94a3b8;padding:20px">No banners yet.</div>';return;}
    grid.innerHTML=allBanners.map((b,i)=>`
      <div class="banner-card" draggable="true" data-id="${esc(b.id)}" data-idx="${i}">
        <div class="banner-preview" style="background:${esc(b.bg_color||'#e8450a')}">
          <div class="banner-active-badge">${b.active?'● Active':'○ Inactive'}</div>
          <div class="banner-icon">${esc(b.icon||'')}</div>
          <div class="banner-title-text">${esc(b.title||'Banner')}</div>
          <div class="banner-subtitle-text">${esc(b.subtitle||'')}</div>
          ${b.cta_text?`<div class="banner-cta-btn">${esc(b.cta_text)}</div>`:''}
        </div>
        <div class="banner-card-actions">
          <button class="btn-icon" onclick="editBanner('${esc(b.id)}')">Edit</button>
          <button class="btn-danger" onclick="deleteBanner('${esc(b.id)}')">Delete</button>
        </div>
      </div>`).join('');
    grid.querySelectorAll('.banner-card').forEach(card=>{
      card.addEventListener('dragstart',e=>{dragSrc=card;e.dataTransfer.effectAllowed='move';card.style.opacity='.4';});
      card.addEventListener('dragend',()=>{card.style.opacity='1';});
      card.addEventListener('dragover',e=>{e.preventDefault();e.dataTransfer.dropEffect='move';});
      card.addEventListener('drop',async e=>{
        e.preventDefault();if(dragSrc===card)return;
        const si=parseInt(dragSrc.dataset.idx),di=parseInt(card.dataset.idx);
        const[m]=allBanners.splice(si,1);allBanners.splice(di,0,m);
        allBanners.forEach((b,i)=>b.sort_order=i+1);renderBanners();
        try{await Promise.all(allBanners.map(b=>dbFetch('/rest/v1/banners?id=eq.'+b.id,{method:'PATCH',body:JSON.stringify({sort_order:b.sort_order})})));}catch(e){}
      });
    });
  }
  const drawerOverlay=document.getElementById('drawerOverlay');
  const bannerDrawer=document.getElementById('bannerDrawer');
  function openDrawer(b){
    document.getElementById('drawerBannerId').value=b?.id||'';
    document.getElementById('drawerTitle').textContent=b?'Edit Banner':'Add Banner';
    document.getElementById('bannerTitle').value=b?.title||'';
    document.getElementById('bannerSubtitle').value=b?.subtitle||'';
    document.getElementById('bannerBody').value=b?.body||'';
    document.getElementById('bannerCtaText').value=b?.cta_text||'';
    document.getElementById('bannerCtaLink').value=b?.cta_link||'';
    document.getElementById('bannerBgColor').value=b?.bg_color||'#e8450a';
    document.getElementById('bannerIcon').value=b?.icon||'';
    document.getElementById('bannerSortOrder').value=b?.sort_order??allBanners.length+1;
    document.getElementById('bannerActive').checked=b?.active!==false;
    document.querySelectorAll('#bannerSwatches .color-swatch').forEach(s=>s.classList.toggle('selected',s.dataset.color===(b?.bg_color||'#e8450a')));
    drawerOverlay.classList.add('open');bannerDrawer.classList.add('open');
  }
  function closeDrawer(){drawerOverlay.classList.remove('open');bannerDrawer.classList.remove('open');}
  document.getElementById('addBannerBtn').addEventListener('click',()=>openDrawer(null));
  document.getElementById('closeDrawer').addEventListener('click',closeDrawer);
  document.getElementById('cancelDrawer').addEventListener('click',closeDrawer);
  drawerOverlay.addEventListener('click',closeDrawer);
  document.querySelectorAll('#bannerSwatches .color-swatch').forEach(s=>{
    s.addEventListener('click',()=>{document.querySelectorAll('#bannerSwatches .color-swatch').forEach(x=>x.classList.remove('selected'));s.classList.add('selected');document.getElementById('bannerBgColor').value=s.dataset.color;});
  });
  document.getElementById('saveBannerBtn').addEventListener('click',async()=>{
    const id=document.getElementById('drawerBannerId').value;
    const payload={title:document.getElementById('bannerTitle').value,subtitle:document.getElementById('bannerSubtitle').value,body:document.getElementById('bannerBody').value,cta_text:document.getElementById('bannerCtaText').value,cta_link:document.getElementById('bannerCtaLink').value,bg_color:document.getElementById('bannerBgColor').value,icon:document.getElementById('bannerIcon').value,sort_order:parseInt(document.getElementById('bannerSortOrder').value)||0,active:document.getElementById('bannerActive').checked};
    try{
      if(id){await dbFetch('/rest/v1/banners?id=eq.'+id,{method:'PATCH',body:JSON.stringify(payload)});const idx=allBanners.findIndex(b=>b.id===id);if(idx>=0)allBanners[idx]={...allBanners[idx],...payload};}
      else{const r=await dbFetch('/rest/v1/banners',{method:'POST',headers:{'Prefer':'return=representation'},body:JSON.stringify(payload)});allBanners.push(Array.isArray(r)?r[0]:{...payload,id:'local-'+Date.now()});}
    }catch(e){if(!id)allBanners.push({...payload,id:'local-'+Date.now()});}
    closeDrawer();renderBanners();
  });
  window.editBanner=(id)=>{const b=allBanners.find(b=>b.id===id);if(b)openDrawer(b);};
  window.deleteBanner=async(id)=>{
    if(!confirm('Delete this banner?'))return;
    try{await dbFetch('/rest/v1/banners?id=eq.'+id,{method:'DELETE'});}catch(e){}
    allBanners=allBanners.filter(b=>b.id!==id);renderBanners();
  };

  // ── TAB 7: CATEGORIES ──
