<script>
  const supabaseUrl = document.querySelector('meta[name="supa-url"]')?.content || '';
  const supabaseKey = document.querySelector('meta[name="supa-key"]')?.content || '';

  // ── AUTH CHECK ──
  async function checkAdminAccess() {
    const loadingEl = document.getElementById('authLoading');
    const deniedEl  = document.getElementById('accessDenied');
    try {
      let token = supabaseKey, userId = null;
      try {
        const prefix = supabaseUrl ? new URL(supabaseUrl).hostname.split('.')[0] : '';
        const stored = JSON.parse(localStorage.getItem('sb-' + prefix + '-auth-token') || '{}');
        if (stored?.access_token) { token = stored.access_token; userId = stored.user?.id; }
      } catch(e) {}

      if (!userId) {
        document.getElementById('adminName').textContent = 'Demo Admin';
        loadingEl.style.display = 'none'; return;
      }
      const res = await fetch(supabaseUrl + '/rest/v1/profiles?select=role,full_name&id=eq.' + userId, {
        headers: { 'apikey': supabaseKey, 'Authorization': 'Bearer ' + token }
      });
      const profiles = await res.json();
      const profile = profiles?.[0];
      if (profile?.role !== 'admin') {
        loadingEl.style.display = 'none';
        deniedEl.style.display = 'flex'; return;
      }
      document.getElementById('adminName').textContent = profile.full_name || 'Admin';
      loadingEl.style.display = 'none';
    } catch(e) {
      document.getElementById('adminName').textContent = 'Demo Admin';
      loadingEl.style.display = 'none';
    }
  }
  checkAdminAccess();

  function getAuthHeader() {
    try {
      const kebayAuth = JSON.parse(localStorage.getItem('kebay-auth') || '{}');
      if (kebayAuth?.access_token) return 'Bearer ' + kebayAuth.access_token;
      const prefix = new URL(supabaseUrl).hostname.split('.')[0];
      const stored = JSON.parse(localStorage.getItem('sb-' + prefix + '-auth-token') || '{}');
      if (stored?.access_token) return 'Bearer ' + stored.access_token;
    } catch(e) {}
    return 'Bearer ' + supabaseKey;
  }

  async function dbFetch(path, options = {}) {
    const headers = { 'apikey': supabaseKey, 'Authorization': getAuthHeader(), 'Content-Type': 'application/json', ...options.headers };
    const res = await fetch(supabaseUrl + path, { ...options, headers });
    if (res.status === 204) return null;
    if (!res.ok) throw new Error(await res.text());
    return res.json();
  }

  // ── DEMO DATA ──
  const DEMO = {
    stats: { users:200, products:450, orders:1230, sellers:85, revenue:345000, newToday:14 },
    orders: [
      { id:'ord-001', product:'Nike Air Max',    buyer:'Jane Mwangi',  seller:'SportHouse', qty:1, total:12500, status:'delivered', created_at: new Date(Date.now()-3600000).toISOString() },
      { id:'ord-002', product:'Samsung TV 43"',  buyer:'Peter Kamau',  seller:'TechZone KE',qty:1, total:45000, status:'shipped',   created_at: new Date(Date.now()-7200000).toISOString() },
      { id:'ord-003', product:'Leather Handbag', buyer:'Mary Njeri',   seller:'FashionHub', qty:2, total:8600,  status:'confirmed', created_at: new Date(Date.now()-10800000).toISOString() },
      { id:'ord-004', product:'Coffee Maker',    buyer:'John Otieno',  seller:'HomeGoods',  qty:1, total:6200,  status:'pending',   created_at: new Date(Date.now()-14400000).toISOString() },
    ],
    categories: [{name:'Electronics',count:142},{name:'Fashion',count:98},{name:'Home',count:87},{name:'Sports',count:65}],
    products: Array.from({length:50},(_,i)=>({
      id:'prod-'+(i+1),
      title:['Nike Air Max','Samsung TV','Leather Bag','Coffee Maker','Adidas Hoodie','iPhone Case','Yoga Mat','Blender','Backpack','Earbuds'][i%10]+' '+(i+1),
      seller:['SportHouse','TechZone KE','FashionHub','HomeGoods','FitLife'][i%5],
      category:['Electronics','Fashion','Home','Sports','Beauty'][i%5],
      price:[12500,45000,4300,6200,3800,600,2400,4500,1600,5800][i%10],
      stock:Math.floor(Math.random()*50)+1, is_active:i%7!==0,
    })),
    users: Array.from({length:30},(_,i)=>({
      id:'user-'+(i+1),
      full_name:['Jane Mwangi','Peter Kamau','Mary Njeri','John Otieno','Alice Wanjiku','David Mutua','Grace Akinyi','Samuel Njeru','Faith Wairimu','Kevin Mungai'][i%10],
      email:['jane','peter','mary','john','alice','david','grace','samuel','faith','kevin'][i%10]+(i+1)+'@example.com',
      role:['buyer','buyer','seller','buyer','admin','seller','buyer','buyer','seller','buyer'][i%10],
      whatsapp_number:'+254'+(700000000+i*11111),
      created_at:new Date(Date.now()-i*86400000*3).toISOString(),
    })),
    banners:[
      {id:'b1',title:'Flash Sale',subtitle:'Up to 50% off electronics',body:'Limited time offer',cta_text:'Shop Now',cta_link:'/search?q=sale',bg_color:'#e8450a',icon:'🔥',sort_order:1,active:true},
      {id:'b2',title:'New Arrivals',subtitle:'Fresh fashion drops',body:'Discover the latest',cta_text:'Explore',cta_link:'/search?q=fashion',bg_color:'#1a7a4a',icon:'✨',sort_order:2,active:true},
    ],
    catList:[
      {id:'cat-1',name:'Electronics',icon:'📱',product_count:142},
      {id:'cat-2',name:'Fashion',icon:'👗',product_count:98},
      {id:'cat-3',name:'Home & Kitchen',icon:'🏠',product_count:87},
      {id:'cat-4',name:'Sports',icon:'⚽',product_count:65},
    ],
  };

  function timeAgo(d){const m=Math.floor((Date.now()-new Date(d))/60000);if(m<1)return'just now';if(m<60)return m+'m ago';const h=Math.floor(m/60);if(h<24)return h+'h ago';return Math.floor(h/24)+'d ago';}
  function avatarColor(n){const c=['#3b82f6','#8b5cf6','#ec4899','#14b8a6','#f59e0b','#10b981','#ef4444','#6366f1'];let h=0;for(const ch of(n||'?'))h=(h*31+ch.charCodeAt(0))&0xffffffff;return c[Math.abs(h)%c.length];}
  function initials(n){return(n||'??').split(' ').map(w=>w[0]).slice(0,2).join('').toUpperCase();}
  function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

  // ── TAB NAVIGATION ──
  document.querySelectorAll('.nav-link[data-tab]').forEach(link=>{
    link.addEventListener('click',e=>{
      e.preventDefault();
      const tab=link.dataset.tab;
      document.querySelectorAll('.nav-link').forEach(l=>l.classList.remove('active'));
      link.classList.add('active');
      document.querySelectorAll('.tab-panel').forEach(p=>p.classList.remove('active'));
      document.getElementById('tab-'+tab)?.classList.add('active');
      document.querySelector('.topbar-title').innerHTML='Admin <span>'+link.textContent.trim()+'</span>';
      if(window.innerWidth<900)closeSidebar();
    });
  });

  // ── SIDEBAR ──
  const sidebarEl=document.getElementById('sidebar');
  const sidebarOverlay=document.getElementById('sidebarOverlay');
  function closeSidebar(){sidebarEl.classList.remove('open');sidebarOverlay.classList.remove('open');}
  document.getElementById('hamburgerBtn').addEventListener('click',()=>{sidebarEl.classList.toggle('open');sidebarOverlay.classList.toggle('open');});
  sidebarOverlay.addEventListener('click',closeSidebar);

  // ── SIGN OUT ──
  document.getElementById('signOutBtn').addEventListener('click',async()=>{
    Object.keys(localStorage).filter(k=>k.includes('-auth-token')).forEach(k=>localStorage.removeItem(k));
    window.location.href='/auth/signin';
  });

  // ── TAB 1: OVERVIEW ──
  async function loadOverview(){
    let stats={...DEMO.stats}, orders=[...DEMO.orders], cats=[...DEMO.categories];
    try{
      const [pRes,prRes,oRes]=await Promise.all([
        fetch(supabaseUrl+'/rest/v1/profiles?select=count',{headers:{'apikey':supabaseKey,'Authorization':getAuthHeader(),'Prefer':'count=exact'}}),
        fetch(supabaseUrl+'/rest/v1/products?select=count',{headers:{'apikey':supabaseKey,'Authorization':getAuthHeader(),'Prefer':'count=exact'}}),
        fetch(supabaseUrl+'/rest/v1/orders?select=id,status,created_at,quantity,products(title,price),buyer:profiles!buyer_id(full_name)&order=created_at.desc&limit=10',{headers:{'apikey':supabaseKey,'Authorization':getAuthHeader()}}),
      ]);
      const pc=parseInt(pRes.headers.get('content-range')?.split('/')[1]||'0');
      const prc=parseInt(prRes.headers.get('content-range')?.split('/')[1]||'0');
      if(pc)stats.users=pc;
      if(prc)stats.products=prc;
      if(oRes.ok){const od=await oRes.json();if(Array.isArray(od)&&od.length)orders=od;}
    }catch(e){}

    const cards=[
