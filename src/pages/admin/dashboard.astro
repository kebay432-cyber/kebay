      return`<div class="activity-item">
        <div class="activity-dot" style="background:${dotColors[st]||'#94a3b8'}"></div>
        <div class="activity-info"><strong>${esc(name)}</strong> <span>by ${esc(buyer)}</span></div>
        <span class="status-badge status-${esc(st)}">${esc(st)}</span>
        <span class="activity-amount">${esc(amount)}</span>
        <span class="activity-time">${timeAgo(o.created_at)}</span>
      </div>`;
    }).join('');

    const mx2=Math.max(...cats.map(c=>c.count));
    document.getElementById('catChart').innerHTML=cats.map(c=>`
      <div class="cat-bar-row">
        <div class="cat-bar-label">${esc(c.name)}</div>
        <div class="cat-bar-track"><div class="cat-bar-fill" style="width:${Math.round((c.count/mx2)*100)}%"></div></div>
        <div class="cat-bar-count">${c.count}</div>
      </div>`).join('');
