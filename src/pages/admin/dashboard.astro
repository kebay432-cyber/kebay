---
export const prerender = true;

const supaUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supaKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — Kebay</title>
  <meta name="supa-url" content={supaUrl} />
  <meta name="supa-key" content={supaKey} />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body.admin-layout {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: #f8fafc; color: #0f172a;
      display: flex; min-height: 100vh; overflow-x: hidden;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* SIDEBAR */
    .sidebar { width:220px; min-width:220px; background:#0f172a; display:flex; flex-direction:column; position:fixed; top:0; left:0; bottom:0; z-index:100; transition:transform .25s ease; }
    .sidebar-logo { padding:20px 16px 16px; border-bottom:1px solid #1e293b; display:flex; align-items:center; gap:10px; }
    .sidebar-logo-mark { width:36px; height:36px; background:#e8450a; border-radius:8px; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
    .sidebar-logo-mark svg { width:20px; height:20px; }
    .sidebar-logo-text { color:#fff; font-weight:700; font-size:1.1rem; letter-spacing:-.3px; }
    .sidebar-logo-sub { color:#64748b; font-size:.65rem; text-transform:uppercase; letter-spacing:1px; }
    .sidebar-nav { flex:1; padding:12px 0; overflow-y:auto; }
    .sidebar-nav a { display:flex; align-items:center; gap:10px; padding:10px 16px; color:#94a3b8; text-decoration:none; font-size:.875rem; font-weight:500; border-left:3px solid transparent; transition:color .15s, border-color .15s, background .15s; cursor:pointer; }
    .sidebar-nav a:hover { color:#e2e8f0; background:#1e293b; }
    .sidebar-nav a.active { color:#fff; border-left-color:#e8450a; background:#1e293b; }
    .sidebar-nav a svg { width:18px; height:18px; flex-shrink:0; }
    .nav-section-label { padding:16px 16px 4px; font-size:.65rem; text-transform:uppercase; letter-spacing:1.2px; color:#475569; font-weight:600; }
    .sidebar-footer { padding:12px 16px; border-top:1px solid #1e293b; color:#64748b; font-size:.75rem; }

    /* MAIN */
    .main-wrapper { margin-left:220px; flex:1; display:flex; flex-direction:column; min-height:100vh; }
    .topbar { background:#fff; border-bottom:1px solid #e2e8f0; padding:0 24px; height:60px; display:flex; align-items:center; gap:16px; position:sticky; top:0; z-index:50; }
    .topbar-hamburger { display:none; background:none; border:none; cursor:pointer; padding:4px; color:#64748b; }
    .topbar-title { font-size:1.1rem; font-weight:700; color:#0f172a; flex:1; }
    .topbar-title span { color:#e8450a; }
    .topbar-actions { display:flex; align-items:center; gap:12px; }
    .topbar-admin-name { font-size:.875rem; font-weight:600; color:#374151; }
    .topbar-admin-role { font-size:.75rem; color:#94a3b8; }
    .topbar-signout { background:#fee2e2; color:#ef4444; border:none; padding:7px 14px; border-radius:7px; font-size:.8rem; font-weight:600; cursor:pointer; transition:background .15s; }
    .topbar-signout:hover { background:#fecaca; }

    /* CONTENT */
    .content { flex:1; padding:24px; }
    .tab-panel { display:none; }
    .tab-panel.active { display:block; }

    /* STAT CARDS */
    .stats-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin-bottom:28px; }
    .stat-card { background:#fff; border-radius:12px; padding:20px 20px 16px; border-left:4px solid #e8450a; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .stat-card-label { font-size:.75rem; text-transform:uppercase; letter-spacing:.8px; color:#94a3b8; font-weight:600; margin-bottom:6px; }
    .stat-card-value { font-size:1.9rem; font-weight:800; color:#0f172a; line-height:1; margin-bottom:8px; }
    .stat-card-footer { display:flex; align-items:center; justify-content:space-between; }
    .stat-badge { font-size:.7rem; font-weight:700; padding:2px 8px; border-radius:20px; }
    .stat-badge.up { background:#dcfce7; color:#16a34a; }
    .stat-badge.down { background:#fee2e2; color:#dc2626; }
    .stat-badge.neutral { background:#f1f5f9; color:#64748b; }
    .sparkline { display:flex; align-items:flex-end; gap:2px; height:24px; }
    .spark-bar { width:4px; border-radius:2px 2px 0 0; background:currentColor; opacity:.5; min-height:3px; }

    /* SECTION */
    .section-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:16px; }
    .section-title { font-size:1rem; font-weight:700; color:#0f172a; }
    .section-subtitle { font-size:.8rem; color:#94a3b8; }

    /* ACTIVITY FEED */
    .activity-feed-card { background:#fff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); overflow:hidden; }
    .activity-feed-header { padding:16px 20px; border-bottom:1px solid #f1f5f9; font-weight:700; font-size:.9rem; }
    .activity-item { display:flex; align-items:center; padding:12px 20px; gap:12px; border-bottom:1px solid #f8fafc; font-size:.825rem; }
    .activity-item:last-child { border-bottom:none; }
    .activity-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .activity-info { flex:1; }
    .activity-info strong { color:#0f172a; }
    .activity-info span { color:#64748b; }
    .activity-amount { font-weight:700; color:#1a7a4a; white-space:nowrap; }
    .activity-time { color:#94a3b8; font-size:.75rem; white-space:nowrap; }
    .status-badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.7rem; font-weight:700; }
    .status-pending   { background:#fef3c7; color:#d97706; }
    .status-confirmed { background:#dbeafe; color:#2563eb; }
    .status-shipped   { background:#e0f2fe; color:#0369a1; }
    .status-delivered { background:#dcfce7; color:#16a34a; }
    .status-active    { background:#dcfce7; color:#16a34a; }
    .status-inactive  { background:#f1f5f9; color:#64748b; }

    /* CATEGORY CHART */
    .cat-chart-card { background:#fff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); padding:20px; }
    .cat-bar-row { display:flex; align-items:center; gap:12px; margin-bottom:10px; font-size:.825rem; }
    .cat-bar-label { width:100px; color:#374151; font-weight:500; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .cat-bar-track { flex:1; height:10px; background:#f1f5f9; border-radius:5px; overflow:hidden; }
    .cat-bar-fill { height:100%; border-radius:5px; background:#e8450a; }
    .cat-bar-count { width:40px; text-align:right; color:#64748b; font-size:.75rem; }

    /* OVERVIEW BOTTOM */
    .overview-bottom { display:grid; grid-template-columns:1fr 1fr; gap:20px; }

    /* ANALYTICS */
    .date-btn-group { display:flex; gap:4px; margin-bottom:24px; }
    .date-btn { padding:7px 16px; border-radius:7px; border:1px solid #e2e8f0; background:#fff; font-size:.8rem; font-weight:600; color:#64748b; cursor:pointer; transition:all .15s; }
    .date-btn.active, .date-btn:hover { background:#e8450a; color:#fff; border-color:#e8450a; }
    .analytics-charts { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:24px; }
    .chart-card { background:#fff; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,.06); }
    .chart-title { font-size:.875rem; font-weight:700; margin-bottom:16px; color:#0f172a; }
    .bar-chart { display:flex; align-items:flex-end; gap:6px; height:100px; }
    .bar-col { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; }
    .bar-col-bar { width:100%; border-radius:4px 4px 0 0; background:#e8450a; min-height:4px; }
    .bar-col-label { font-size:.6rem; color:#94a3b8; }
    .bar-col-bar.green { background:#1a7a4a; }
    .analytics-bottom { display:grid; grid-template-columns:2fr 1fr; gap:20px; }

    /* PROGRESS BARS */
    .progress-label { display:flex; justify-content:space-between; font-size:.8rem; margin-bottom:6px; }
    .progress-track { height:10px; background:#f1f5f9; border-radius:5px; overflow:hidden; margin-bottom:14px; }
    .progress-fill { height:100%; border-radius:5px; }
    .progress-fill.buyers { background:#3b82f6; }
    .progress-fill.sellers { background:#1a7a4a; }

    /* TABLES */
    .table-wrapper { background:#fff; border-radius:12px; box-shadow:0 1px 4px rgba(0,0,0,.06); overflow:hidden; }
    .table-toolbar { padding:14px 20px; display:flex; gap:10px; border-bottom:1px solid #f1f5f9; flex-wrap:wrap; align-items:center; }
    .table-toolbar input[type="text"], .table-toolbar select { padding:7px 12px; border:1px solid #e2e8f0; border-radius:7px; font-size:.825rem; outline:none; background:#f8fafc; }
    .table-toolbar input[type="text"]:focus, .table-toolbar select:focus { border-color:#e8450a; background:#fff; }
    .table-toolbar .spacer { flex:1; }
    .btn-primary { background:#e8450a; color:#fff; border:none; padding:8px 16px; border-radius:7px; font-size:.8rem; font-weight:600; cursor:pointer; }
    .btn-primary:hover { background:#c73a08; }
    .btn-secondary { background:#f1f5f9; color:#374151; border:1px solid #e2e8f0; padding:7px 14px; border-radius:7px; font-size:.8rem; font-weight:600; cursor:pointer; }
    .btn-secondary:hover { background:#e2e8f0; }
    .btn-danger { background:#fee2e2; color:#ef4444; border:none; padding:5px 10px; border-radius:6px; font-size:.75rem; font-weight:600; cursor:pointer; }
    .btn-danger:hover { background:#fecaca; }
    .btn-icon { background:none; border:1px solid #e2e8f0; padding:5px 9px; border-radius:6px; font-size:.75rem; cursor:pointer; color:#374151; }
    .btn-icon:hover { background:#f1f5f9; }
    table { width:100%; border-collapse:collapse; }
    thead th { background:#f8fafc; padding:10px 14px; text-align:left; font-size:.75rem; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:#64748b; border-bottom:1px solid #e2e8f0; }
    tbody tr { border-bottom:1px solid #f1f5f9; }
    tbody tr:nth-child(even) { background:#f9fafb; }
    tbody tr:hover { background:#f1f5f9; }
    tbody td { padding:10px 14px; font-size:.825rem; vertical-align:middle; }
    .pagination { display:flex; align-items:center; justify-content:space-between; padding:12px 20px; border-top:1px solid #f1f5f9; font-size:.8rem; color:#64748b; }
    .pagination-btns { display:flex; gap:6px; }
    .avatar-circle { width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.75rem; font-weight:700; color:#fff; flex-shrink:0; }
    .role-badge { display:inline-block; padding:2px 8px; border-radius:20px; font-size:.7rem; font-weight:700; }
    .role-buyer  { background:#dbeafe; color:#1d4ed8; }
    .role-seller { background:#dcfce7; color:#15803d; }
    .role-admin  { background:#fed7aa; color:#c2410c; }

    /* ORDERS */
    .order-status-tabs { display:flex; gap:4px; margin-bottom:16px; }
    .order-tab-btn { padding:7px 16px; border-radius:7px; border:1px solid #e2e8f0; background:#fff; font-size:.8rem; font-weight:600; color:#64748b; cursor:pointer; }
    .order-tab-btn.active { background:#0f172a; color:#fff; border-color:#0f172a; }
    .expanded-row td { background:#f0fdf4 !important; }
    .order-detail-panel { padding:12px 16px; background:#f0fdf4; border-radius:8px; font-size:.825rem; display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
    .order-detail-panel dt { color:#64748b; font-size:.7rem; text-transform:uppercase; letter-spacing:.6px; }
    .order-detail-panel dd { font-weight:600; color:#0f172a; }
    .bulk-bar { display:flex; align-items:center; gap:10px; padding:10px 20px; background:#f8fafc; border-bottom:1px solid #e2e8f0; font-size:.825rem; }
    .bulk-bar select { padding:5px 10px; border:1px solid #e2e8f0; border-radius:6px; font-size:.8rem; }

    /* BANNERS */
    .banners-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(260px,1fr)); gap:16px; margin-top:16px; }
    .banner-card { border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,.08); cursor:grab; }
    .banner-preview { padding:20px; position:relative; }
    .banner-icon { font-size:1.8rem; margin-bottom:6px; }
    .banner-title-text { font-size:1rem; font-weight:800; color:#fff; margin-bottom:2px; }
    .banner-subtitle-text { font-size:.75rem; color:rgba(255,255,255,.8); margin-bottom:10px; }
    .banner-cta-btn { display:inline-block; background:rgba(255,255,255,.25); color:#fff; padding:5px 14px; border-radius:20px; font-size:.75rem; font-weight:600; border:1px solid rgba(255,255,255,.4); }
    .banner-active-badge { position:absolute; top:10px; right:10px; background:rgba(0,0,0,.35); color:#fff; font-size:.65rem; padding:2px 8px; border-radius:20px; font-weight:700; }
    .banner-card-actions { background:#fff; padding:10px 14px; display:flex; gap:8px; border-top:1px solid #f1f5f9; }

    /* DRAWER */
    .drawer-overlay { position:fixed; inset:0; background:rgba(0,0,0,.35); z-index:9998; display:none; }
    .drawer-overlay.open { display:block; }
    .drawer { position:fixed; top:0; right:0; bottom:0; width:400px; max-width:100vw; background:#fff; z-index:9999; transform:translateX(100%); transition:transform .25s ease; display:flex; flex-direction:column; box-shadow:-4px 0 24px rgba(0,0,0,.12); }
    .drawer.open { transform:translateX(0); }
    .drawer-header { padding:20px 20px 16px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between; }
    .drawer-header h3 { font-size:.95rem; font-weight:700; }
    .drawer-close { background:none; border:none; font-size:1.3rem; cursor:pointer; color:#64748b; }
    .drawer-body { flex:1; overflow-y:auto; padding:20px; }
    .drawer-footer { padding:16px 20px; border-top:1px solid #f1f5f9; display:flex; gap:10px; }
    .form-field { margin-bottom:16px; }
    .form-label { display:block; font-size:.8rem; font-weight:600; color:#374151; margin-bottom:5px; }
    .form-input, .form-select, .form-textarea { width:100%; padding:8px 12px; border:1px solid #e2e8f0; border-radius:7px; font-size:.85rem; outline:none; font-family:inherit; }
    .form-input:focus, .form-select:focus, .form-textarea:focus { border-color:#e8450a; }
    .form-textarea { resize:vertical; min-height:80px; }
    .color-swatches { display:flex; flex-wrap:wrap; gap:8px; margin-top:6px; }
    .color-swatch { width:32px; height:32px; border-radius:6px; cursor:pointer; border:3px solid transparent; transition:border-color .15s; }
    .color-swatch.selected { border-color:#0f172a; }
    .toggle-row { display:flex; align-items:center; justify-content:space-between; }
    .toggle { position:relative; width:44px; height:24px; }
    .toggle input { opacity:0; width:0; height:0; }
    .toggle-track { position:absolute; inset:0; background:#cbd5e1; border-radius:12px; cursor:pointer; transition:background .2s; }
    .toggle input:checked + .toggle-track { background:#1a7a4a; }
    .toggle-track::after { content:''; position:absolute; top:2px; left:2px; width:20px; height:20px; background:#fff; border-radius:50%; transition:transform .2s; box-shadow:0 1px 4px rgba(0,0,0,.2); }
    .toggle input:checked + .toggle-track::after { transform:translateX(20px); }

    /* CATEGORIES */
    .categories-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(180px,1fr)); gap:14px; margin-top:16px; }
    .category-card { background:#fff; border-radius:12px; padding:20px; box-shadow:0 1px 4px rgba(0,0,0,.06); text-align:center; }
    .category-card-icon { font-size:2.5rem; margin-bottom:8px; }
    .category-card-name { font-weight:700; font-size:.9rem; color:#0f172a; margin-bottom:4px; }
    .category-card-count { font-size:.75rem; color:#94a3b8; margin-bottom:12px; }
    .category-card-actions { display:flex; gap:6px; justify-content:center; }

    /* SETTINGS */
    .settings-section { background:#fff; border-radius:12px; padding:24px; box-shadow:0 1px 4px rgba(0,0,0,.06); margin-bottom:20px; }
    .settings-section-title { font-size:.9rem; font-weight:700; color:#0f172a; margin-bottom:16px; padding-bottom:12px; border-bottom:1px solid #f1f5f9; }
    .settings-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; margin-bottom:16px; }
    .settings-note { font-size:.75rem; color:#94a3b8; margin-top:6px; }
    .maintenance-row { display:flex; align-items:center; gap:16px; }
    .maintenance-label { flex:1; font-size:.875rem; color:#374151; }

    /* MOBILE */
    @media (max-width:900px) {
      .sidebar { transform:translateX(-100%); }
      .sidebar.open { transform:translateX(0); }
      .main-wrapper { margin-left:0; }
      .topbar-hamburger { display:flex; }
      .stats-grid { grid-template-columns:repeat(2,1fr); }
      .analytics-charts, .overview-bottom, .analytics-bottom { grid-template-columns:1fr; }
      .settings-grid { grid-template-columns:1fr; }
      .order-detail-panel { grid-template-columns:repeat(2,1fr); }
    }
    @media (max-width:540px) {
      .stats-grid { grid-template-columns:1fr; }
      .content { padding:16px; }
    }
    .sidebar-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:99; }
    .sidebar-overlay.open { display:block; }
  </style>
</head>
<body class="admin-layout">

<!-- Loading screen -->
<div id="authLoading" style="position:fixed;inset:0;background:#fff;display:flex;align-items:center;justify-content:center;z-index:9999;flex-direction:column;gap:16px;">
  <div style="width:40px;height:40px;border:3px solid #e5e5e5;border-top-color:#e8450a;border-radius:50%;animation:spin .7s linear infinite;"></div>
  <div style="font-size:14px;color:#888;">Checking access…</div>
</div>

<!-- Access denied screen -->
<div id="accessDenied" style="display:none;position:fixed;inset:0;background:#f9fafb;align-items:center;justify-content:center;z-index:9998;">
  <div style="text-align:center;padding:40px;">
    <div style="font-size:48px;margin-bottom:16px;">🔒</div>
    <h1 style="font-size:22px;font-weight:800;margin-bottom:8px;">Access Denied</h1>
    <p style="color:#666;margin-bottom:20px;">You need admin privileges to view this page.</p>
    <a href="/auth/signin" style="display:inline-block;padding:11px 28px;background:#e8450a;color:#fff;border-radius:50px;font-weight:700;text-decoration:none;">Sign In as Admin</a>
  </div>
</div>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- SIDEBAR -->
<nav class="sidebar" id="sidebar">
  <div class="sidebar-logo">
    <div class="sidebar-logo-mark">
      <svg viewBox="0 0 20 20" fill="none"><path d="M3 4h14l-1.5 9H4.5L3 4Z" fill="white" opacity=".9"/><circle cx="7" cy="17" r="1.5" fill="white"/><circle cx="14" cy="17" r="1.5" fill="white"/></svg>
    </div>
    <div>
      <div class="sidebar-logo-text">Kebay</div>
      <div class="sidebar-logo-sub">Admin Panel</div>
    </div>
  </div>
  <div class="sidebar-nav">
    <div class="nav-section-label">Main</div>
    <a href="#" class="nav-link active" data-tab="overview">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
      Overview
    </a>
    <a href="#" class="nav-link" data-tab="analytics">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      Analytics
    </a>
    <div class="nav-section-label">Store</div>
    <a href="#" class="nav-link" data-tab="products">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2Z"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/></svg>
      Products
    </a>
    <a href="#" class="nav-link" data-tab="users">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
      Users
    </a>
    <a href="#" class="nav-link" data-tab="orders">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2"/><rect x="9" y="3" width="6" height="4" rx="1"/><path d="m9 12 2 2 4-4"/></svg>
      Orders
    </a>
    <div class="nav-section-label">Content</div>
    <a href="#" class="nav-link" data-tab="banners">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><path d="M2 10h20"/></svg>
      Banners &amp; Ads
    </a>
    <a href="#" class="nav-link" data-tab="categories">
