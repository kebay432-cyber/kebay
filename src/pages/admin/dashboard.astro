      {label:'Total Products',value:stats.products,color:'#8b5cf6',badge:'+12%',dir:'up',spark:[30,40,55,45,65,70,80]},
      {label:'Total Orders',value:stats.orders.toLocaleString('en-KE'),color:'#e8450a',badge:'+15%',dir:'up',spark:[50,60,45,70,65,80,90]},
      {label:'Active Sellers',value:stats.sellers,color:'#1a7a4a',badge:'+5%',dir:'up',spark:[60,65,70,68,75,72,78]},
      {label:'Revenue (KSh)',value:'KSh '+stats.revenue.toLocaleString('en-KE'),color:'#f59e0b',badge:'+18%',dir:'up',spark:[35,50,45,65,55,75,70]},
      {label:'New Today',value:stats.newToday,color:'#ec4899',badge:'0%',dir:'neutral',spark:[8,10,7,14,9,12,14]},
    ];
    document.getElementById('statsGrid').innerHTML=cards.map(c=>{
      const mx=Math.max(...c.spark);
      const sb=c.spark.map(v=>`<div class="spark-bar" style="height:${Math.round((v/mx)*100)}%;color:${c.color}"></div>`).join('');
