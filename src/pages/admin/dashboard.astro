        <div class="stat-card-label">${esc(c.label)}</div>
        <div class="stat-card-value" style="color:${c.color}">${esc(String(c.value))}</div>
        <div class="stat-card-footer"><span class="stat-badge ${c.dir}">${esc(c.badge)} this week</span><div class="sparkline" style="color:${c.color}">${sb}</div></div>
      </div>`;
    }).join('');

    const dotColors={delivered:'#16a34a',shipped:'#0369a1',confirmed:'#2563eb',pending:'#d97706'};
    document.getElementById('activityFeed').innerHTML=orders.map(o=>{
      const name=o.products?.title||o.product||'Product';
      const buyer=o.buyer?.full_name||o.buyer||'Buyer';
      const amount=o.products?.price?'KSh '+(o.products.price*(o.quantity||1)).toLocaleString('en-KE'):(o.total?'KSh '+o.total.toLocaleString('en-KE'):'—');
