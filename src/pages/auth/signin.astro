---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Sign In — Kebay">
  <Header />
  <main>
    <div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:24px 16px;">
      <div style="width:100%;max-width:400px;">

        <div style="text-align:center;margin-bottom:28px;">
          <a href={`${base}/`} style="font-size:36px;font-weight:900;letter-spacing:-1px;text-decoration:none;">
            <span style="color:#e8450a;">K</span><span style="color:#1a7a4a;">e</span><span style="color:#e8450a;">b</span><span style="color:#333;">a</span><span style="color:#1a7a4a;">y</span>
          </a>
          <p style="color:#666;margin-top:8px;font-size:14px;">Sign in to your account</p>
        </div>

        <div id="errorMsg" style="display:none;padding:12px 16px;border-radius:10px;background:#fff5f5;color:#c0392b;border:1px solid #fcc;font-size:14px;margin-bottom:16px;"></div>
        <div id="infoMsg" style="display:none;padding:12px 16px;border-radius:10px;background:#fffbe6;color:#856404;border:1px solid #ffe;font-size:14px;margin-bottom:16px;"></div>

        <form id="signinForm" style="background:#fff;border:1px solid #e5e5e5;border-radius:16px;padding:28px;">
          <div style="margin-bottom:16px;">
            <label style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;">📧 Email</label>
            <input id="email" type="email" placeholder="you@email.com" required
              style="width:100%;padding:12px 16px;border:1.5px solid #e5e5e5;border-radius:8px;font-size:15px;outline:none;" />
          </div>
          <div style="margin-bottom:20px;">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px;">
              <label style="font-size:14px;font-weight:600;">🔒 Password</label>
          <a href={`${base}/auth/forgot-password`} style="font-size:13px;color:#e8450a;font-weight:600;">Forgot password?</a>
            </div>
            <input id="password" type="password" placeholder="Your password" required
              style="width:100%;padding:12px 16px;border:1.5px solid #e5e5e5;border-radius:8px;font-size:15px;outline:none;" />
          </div>
          <button type="submit" id="submitBtn"
            style="width:100%;padding:14px;background:#e8450a;color:#fff;border:none;border-radius:50px;font-size:16px;font-weight:700;cursor:pointer;">
            Sign In
          </button>
        </form>

        <div style="text-align:center;margin-top:20px;font-size:15px;">
          No account? <a href={`${base}/auth/register`} style="color:#e8450a;font-weight:700;">Register free</a>
        </div>
        <div style="text-align:center;margin-top:10px;font-size:13px;">
          Seller? <a href={`${base}/auth/register?role=seller`} style="color:#1a7a4a;font-weight:600;">Register as Seller</a>
        </div>

        <!-- Setup check -->
        <div id="setupWarning" style="display:none;margin-top:20px;padding:14px;background:#fffbe6;border:1px solid #ffe58f;border-radius:10px;font-size:13px;color:#614700;">
          ⚠️ <strong>Database not set up yet.</strong><br>
          Run the SQL migration in your Supabase project first.<br>
          See <code>supabase/migrations/001_initial.sql</code>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  // Check Supabase is reachable
  async function checkSetup() {
    try {
      const { error } = await supabase.from('profiles').select('id').limit(1);
      if (error && (error.code === '42P01' || error.message?.includes('does not exist'))) {
        document.getElementById('setupWarning')!.style.display = 'block';
      }
    } catch {}
  }
  checkSetup();

  document.getElementById('signinForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn') as HTMLButtonElement;
    const errorEl = document.getElementById('errorMsg')!;
    const infoEl  = document.getElementById('infoMsg')!;
    const email    = (document.getElementById('email') as HTMLInputElement).value.trim();
    const password = (document.getElementById('password') as HTMLInputElement).value;

    btn.textContent = 'Signing in…';
    btn.disabled = true;
    errorEl.style.display = 'none';
    infoEl.style.display  = 'none';

    const { data, error } = await supabase.auth.signInWithPassword({ email, password });

    if (error) {
      // Translate Supabase error messages into plain English
      let msg = error.message;
      if (msg.includes('Invalid login credentials') || msg.includes('invalid_credentials')) {
        msg = 'Wrong email or password. Please try again.';
      } else if (msg.includes('Email not confirmed') || msg.includes('email_not_confirmed')) {
        msg = '';
        infoEl.innerHTML = `📧 <strong>Please confirm your email first.</strong><br>
          Check your inbox for a confirmation link from Supabase, then try signing in again.<br><br>
          <strong>Didn't get it?</strong> Check spam, or
          <button id="resendBtn" style="color:#e8450a;font-weight:700;background:none;border:none;cursor:pointer;font-size:13px;text-decoration:underline;">resend confirmation email</button>.`;
        infoEl.style.display = 'block';

        document.getElementById('resendBtn')?.addEventListener('click', async () => {
          const { error: resendErr } = await supabase.auth.resend({ type: 'signup', email });
          if (!resendErr) {
            infoEl.innerHTML = '✅ Confirmation email resent — check your inbox.';
          }
        });
      } else if (msg.includes('rate limit') || msg.includes('too many')) {
        msg = 'Too many attempts. Please wait a minute and try again.';
      } else if (msg.includes('fetch') || msg.includes('network')) {
        msg = 'Connection error. Check your internet and try again.';
      }

      if (msg) {
        errorEl.textContent = msg;
        errorEl.style.display = 'block';
      }
      btn.textContent = 'Sign In';
      btn.disabled = false;
    } else {
      btn.textContent = '✅ Signed in!';
      // Store user role in localStorage for UI hints
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', data.user!.id).single();
      if (profile) localStorage.setItem('kebay_role', profile.role);
      const B = (window as any).BASE_URL || '';
      window.location.href = B + '/';
    }
  });
</script>
