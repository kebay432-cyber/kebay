---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Forgot Password — Kebay">
  <Header />
  <main>
    <div style="min-height:70vh;display:flex;align-items:center;justify-content:center;padding:24px 16px;">
      <div style="width:100%;max-width:400px;">

        <div style="text-align:center;margin-bottom:28px;">
          <a href="/" style="font-size:36px;font-weight:900;letter-spacing:-1px;text-decoration:none;">
            <span style="color:#e8450a;">K</span><span style="color:#1a7a4a;">e</span><span style="color:#e8450a;">b</span><span style="color:#333;">a</span><span style="color:#1a7a4a;">y</span>
          </a>
          <p style="color:#666;margin-top:8px;font-size:14px;">Reset your password</p>
        </div>

        <div id="errorMsg" style="display:none;padding:12px 16px;border-radius:10px;background:#fff5f5;color:#c0392b;border:1px solid #fcc;font-size:14px;margin-bottom:16px;"></div>
        <div id="successMsg" style="display:none;padding:12px 16px;border-radius:10px;background:#f0fff4;color:#1a7a4a;border:1px solid #c6f6d5;font-size:14px;margin-bottom:16px;"></div>

        <form id="forgotForm" style="background:#fff;border:1px solid #e5e5e5;border-radius:16px;padding:28px;">
          <div style="margin-bottom:20px;">
            <label style="display:block;font-size:14px;font-weight:600;margin-bottom:6px;">📧 Email address</label>
            <input id="email" type="email" placeholder="you@email.com" required
              style="width:100%;padding:12px 16px;border:1.5px solid #e5e5e5;border-radius:8px;font-size:15px;outline:none;" />
          </div>
          <button type="submit" id="submitBtn"
            style="width:100%;padding:14px;background:#e8450a;color:#fff;border:none;border-radius:50px;font-size:16px;font-weight:700;cursor:pointer;">
            Send reset link
          </button>
        </form>

        <div style="text-align:center;margin-top:20px;font-size:14px;">
          <a href={`${base}/auth/signin`} style="color:#e8450a;font-weight:600;">← Back to Sign In</a>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  document.getElementById('forgotForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('submitBtn') as HTMLButtonElement;
    const errorEl = document.getElementById('errorMsg')!;
    const successEl = document.getElementById('successMsg')!;
    const email = (document.getElementById('email') as HTMLInputElement).value.trim();

    btn.textContent = 'Sending…';
    btn.disabled = true;
    errorEl.style.display = 'none';
    successEl.style.display = 'none';

    const { error } = await supabase.auth.resetPasswordForEmail(email, {
      redirectTo: `${window.location.origin}${(window as any).BASE_URL || ''}/auth/reset-password`,
    });

    if (error) {
      errorEl.textContent = error.message;
      errorEl.style.display = 'block';
      btn.textContent = 'Send reset link';
      btn.disabled = false;
    } else {
      successEl.textContent = 'Check your email for a reset link.';
      successEl.style.display = 'block';
      btn.textContent = '✅ Email sent';
    }
  });
</script>
