---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="My Dashboard — Kebay">
  <Header />

  <style>
    .tab-bar { display:flex; border-bottom:2px solid #e5e5e5; margin-bottom:24px; overflow-x:auto; scrollbar-width:none; }
    .tab-bar::-webkit-scrollbar { display:none; }
    .tab-btn { padding:12px 20px; font-size:15px; font-weight:700; border:none; background:none; cursor:pointer; border-bottom:3px solid transparent; color:#888; margin-bottom:-2px; white-space:nowrap; transition:all .15s; }
    .tab-btn.active { border-bottom-color:#e8450a; color:#e8450a; }
    .card { background:#fff; border:1px solid #e5e5e5; border-radius:14px; padding:24px; margin-bottom:16px; }
    .form-input { width:100%; padding:10px 13px; border:1.5px solid #e5e5e5; border-radius:8px; font-size:14px; outline:none; box-sizing:border-box; }
    .form-input:focus { border-color:#e8450a; }
    .order-card { background:#fff; border:1px solid #e5e5e5; border-radius:14px; overflow:hidden; margin-bottom:14px; }
    .progress-bar { display:flex; align-items:center; padding:14px 16px 16px; background:#fafafa; border-top:1px solid #f0f0f0; }
    .progress-step { flex:1; display:flex; flex-direction:column; align-items:center; gap:4px; position:relative; }
    .progress-step:not(:last-child)::after { content:''; position:absolute; top:14px; left:50%; right:-50%; height:2px; background:#e5e5e5; z-index:0; }
    .progress-step.done:not(:last-child)::after { background:#e8450a; }
    .step-dot { width:28px; height:28px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:13px; font-weight:700; position:relative; z-index:1; }
    .step-label { font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:.3px; }
    .status-pill { padding:4px 12px; border-radius:50px; font-size:12px; font-weight:700; }
    .wish-card { display:flex; gap:12px; align-items:center; padding:14px 0; border-bottom:1px solid #f0f0f0; }
    @media(max-width:768px) {
      .tab-btn { padding:10px 14px; font-size:13px; }
    }
  </style>

  <main>
    <div class="container" style="padding-top:24px;padding-bottom:60px;max-width:760px;">

      <!-- Header -->
      <div style="margin-bottom:20px;">
        <h1 style="font-size:24px;font-weight:900;margin-bottom:2px;">👤 My Dashboard</h1>
        <p style="color:#888;font-size:14px;" id="welcomeName">Loading…</p>
      </div>

      <!-- Demo notice -->
      <div id="demoNotice" style="display:none;padding:12px 18px;background:#fffbe6;border:1px solid #ffe58f;border-radius:12px;margin-bottom:20px;font-size:14px;">
        💡 <strong>Demo mode</strong> — <a href="/auth/signin" style="color:#e8450a;font-weight:700;">Sign in</a> to see your real data.
      </div>

      <!-- Tabs -->
      <div class="tab-bar">
        <button class="tab-btn active" data-tab="profile">👤 Profile</button>
        <button class="tab-btn" data-tab="orders">📦 Orders</button>
        <button class="tab-btn" data-tab="wishlist">❤️ Wishlist</button>
        <button class="tab-btn" data-tab="settings">⚙️ Settings</button>
      </div>

      <!-- PROFILE TAB -->
      <div id="tab-profile">
        <div class="card">
          <h3 style="font-size:16px;font-weight:800;margin-bottom:16px;">Your Profile</h3>
          <div style="margin-bottom:14px;">
            <label style="font-size:12px;font-weight:600;color:#888;display:block;margin-bottom:4px;">FULL NAME</label>
            <input id="pName" type="text" class="form-input" placeholder="Your full name" />
          </div>
          <div style="margin-bottom:14px;">
            <label style="font-size:12px;font-weight:600;color:#888;display:block;margin-bottom:4px;">WHATSAPP NUMBER</label>
            <input id="pWa" type="tel" class="form-input" placeholder="e.g. 254712345678" />
          </div>
          <div style="margin-bottom:20px;">
            <label style="font-size:12px;font-weight:600;color:#888;display:block;margin-bottom:4px;">LOCATION</label>
            <input id="pLocation" type="text" class="form-input" placeholder="e.g. Nairobi, Kenya" />
          </div>
          <button id="saveProfileBtn" style="padding:12px 28px;background:#e8450a;color:#fff;border:none;border-radius:50px;font-weight:700;font-size:15px;cursor:pointer;">Save Changes</button>
          <div id="profileSaved" style="display:none;margin-top:10px;font-size:13px;color:#1a7a4a;font-weight:600;">✅ Saved!</div>
        </div>
      </div>

      <!-- ORDERS TAB -->
      <div id="tab-orders" style="display:none;">
        <div style="display:flex;justify-content:flex-end;margin-bottom:14px;">
          <select id="filterStatus" style="padding:9px 14px;border:1.5px solid #e5e5e5;border-radius:50px;font-size:14px;background:#fff;outline:none;cursor:pointer;">
            <option value="all">All Orders</option>
            <option value="pending">⏳ Pending</option>
            <option value="confirmed">✅ Confirmed</option>
            <option value="shipped">🚚 Shipped</option>
            <option value="delivered">🎉 Delivered</option>
          </select>
        </div>
        <div id="ordersEmpty" style="display:none;text-align:center;padding:60px 20px;color:#888;">
          <div style="font-size:56px;margin-bottom:16px;">📦</div>
          <div style="font-size:18px;font-weight:700;color:#333;margin-bottom:8px;">No orders yet</div>
          <a href="/search" style="display:inline-block;padding:12px 28px;background:#e8450a;color:#fff;border-radius:50px;font-weight:700;">Shop Now</a>
        </div>
        <div id="ordersList"></div>
      </div>

      <!-- WISHLIST TAB -->
      <div id="tab-wishlist" style="display:none;">
        <div id="wishlistEmpty" style="display:none;text-align:center;padding:60px 20px;color:#888;">
          <div style="font-size:56px;margin-bottom:16px;">❤️</div>
          <div style="font-size:18px;font-weight:700;color:#333;margin-bottom:8px;">Your wishlist is empty</div>
          <p>Heart products to save them here.</p>
          <a href="/search" style="display:inline-block;padding:12px 28px;background:#e8450a;color:#fff;border-radius:50px;font-weight:700;margin-top:16px;">Browse Products</a>
        </div>
        <div id="wishlistItems"></div>
      </div>

      <!-- SETTINGS TAB -->
      <div id="tab-settings" style="display:none;">
        <div class="card">
          <h3 style="font-size:16px;font-weight:800;margin-bottom:16px;">🔒 Change Password</h3>
          <div style="margin-bottom:14px;">
            <label style="font-size:12px;font-weight:600;color:#888;display:block;margin-bottom:4px;">NEW PASSWORD</label>
            <input id="newPassword" type="password" class="form-input" placeholder="New password (min 6 chars)" />
          </div>
          <div style="margin-bottom:20px;">
            <label style="font-size:12px;font-weight:600;color:#888;display:block;margin-bottom:4px;">CONFIRM PASSWORD</label>
            <input id="confirmPassword" type="password" class="form-input" placeholder="Repeat new password" />
          </div>
          <button id="changePasswordBtn" style="padding:12px 28px;background:#111;color:#fff;border:none;border-radius:50px;font-weight:700;font-size:15px;cursor:pointer;">Update Password</button>
          <div id="pwSaved" style="display:none;margin-top:10px;font-size:13px;color:#1a7a4a;font-weight:600;">✅ Password updated!</div>
          <div id="pwError" style="display:none;margin-top:10px;font-size:13px;color:#e53e3e;font-weight:600;"></div>
        </div>

        <div class="card" style="border-color:#fcc;">
          <h3 style="font-size:16px;font-weight:800;margin-bottom:8px;">Sign Out</h3>
          <p style="font-size:14px;color:#666;margin-bottom:16px;">You will be signed out of your Kebay account.</p>
          <button id="signOutBtn" style="padding:12px 28px;background:#e53e3e;color:#fff;border:none;border-radius:50px;font-weight:700;font-size:15px;cursor:pointer;">Sign Out</button>
        </div>
      </div>

    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { supabase } from '../../lib/supabase';

  function ksh(n: number) { return `KSh ${n.toLocaleString('en-KE')}`; }

  const statusStyle: Record<string, string> = {
    pending:   'background:#fff9c4;color:#856404;',
    confirmed: 'background:#dbeafe;color:#1d4ed8;',
    shipped:   'background:#ede9fe;color:#7c3aed;',
    delivered: 'background:#dcfce7;color:#15803d;',
  };
  const statusIcon: Record<string, string> = { pending:'⏳', confirmed:'✅', shipped:'🚚', delivered:'🎉' };
  const steps = ['pending','confirmed','shipped','delivered'];

  const demoOrders = [
    { id:'ORD-KBY-001', status:'delivered', quantity:1, created_at:'2026-11-20T10:00:00Z', products:{ id:'demo-1', title:'Samsung Galaxy A55 5G', images:['https://picsum.photos/seed/phone1/300/300'], price:45000, profiles:{ full_name:'TechHub Kenya', whatsapp_number:'254712345678' } } },
    { id:'ORD-KBY-002', status:'shipped', quantity:1, created_at:'2026-11-22T14:00:00Z', products:{ id:'demo-2', title:'HP Laptop 15s Intel i5', images:['https://picsum.photos/seed/laptop1/300/300'], price:68000, profiles:{ full_name:'PC World', whatsapp_number:'254722345678' } } },
    { id:'ORD-KBY-003', status:'pending', quantity:2, created_at:'2026-11-24T09:00:00Z', products:{ id:'demo-3', title:'Nike Air Max 270', images:['https://picsum.photos/seed/shoes1/300/300'], price:12000, profiles:{ full_name:'Sneaker Zone', whatsapp_number:'254733345678' } } },
  ];

  let allOrders: any[] = [];

  // ── Tab switching ──
  const tabNames = ['profile','orders','wishlist','settings'];
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      const tab = (btn as HTMLElement).dataset.tab!;
      tabNames.forEach(t => {
        const el = document.getElementById(`tab-${t}`);
        if (el) el.style.display = t === tab ? 'block' : 'none';
      });
    });
  });

  function renderOrders() {
    const filter = (document.getElementById('filterStatus') as HTMLSelectElement).value;
    const list = document.getElementById('ordersList')!;
    const empty = document.getElementById('ordersEmpty')!;
    const filtered = filter === 'all' ? allOrders : allOrders.filter((o: any) => o.status === filter);

    if (filtered.length === 0) { empty.style.display = 'block'; list.innerHTML = ''; return; }
    empty.style.display = 'none';

    list.innerHTML = filtered.map((o: any) => {
      const p = o.products;
      const currentStep = steps.indexOf(o.status);
      const date = new Date(o.created_at).toLocaleDateString('en-KE', { day:'numeric', month:'short', year:'numeric' });
      const waText = encodeURIComponent(`Hi, following up on my order for: ${p?.title} — Order #${o.id}`);
      const waLink = p?.profiles?.whatsapp_number ? `https://wa.me/${p.profiles.whatsapp_number}?text=${waText}` : '#';
      return `
        <div class="order-card">
          <div style="display:flex;gap:12px;align-items:flex-start;padding:14px;">
            <a href="/product/${p?.id}">
              <img src="${p?.images?.[0] || 'https://picsum.photos/80'}" style="width:76px;height:76px;object-fit:cover;border-radius:10px;background:#f5f5f5;flex-shrink:0;" />
            </a>
            <div style="flex:1;min-width:0;">
              <a href="/product/${p?.id}" style="font-weight:700;font-size:15px;line-height:1.3;display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#111;">${p?.title || 'Product'}</a>
              <div style="font-size:15px;font-weight:900;color:#111;margin-top:4px;">${ksh((p?.price || 0) * o.quantity)}</div>
              <div style="font-size:12px;color:#999;margin-top:2px;">Qty: ${o.quantity} &nbsp;·&nbsp; ${date}</div>
              <div style="font-size:12px;color:#888;margin-top:2px;">Seller: <strong>${p?.profiles?.full_name || 'Seller'}</strong></div>
            </div>
            <span class="status-pill" style="${statusStyle[o.status] || ''};flex-shrink:0;">${statusIcon[o.status] || ''} ${o.status.charAt(0).toUpperCase()+o.status.slice(1)}</span>
          </div>
          <div class="progress-bar">
            ${steps.map((s, i) => {
              const done = i <= currentStep;
              const isCurrent = i === currentStep;
              return `<div class="progress-step ${done ? 'done' : ''}">
                <div class="step-dot" style="${done ? 'background:#e8450a;color:#fff;' : 'background:#f0f0f0;color:#aaa;'}${isCurrent ? 'box-shadow:0 0 0 3px rgba(232,69,10,.2);' : ''}">${done ? (isCurrent ? statusIcon[s] : '✓') : (i + 1)}</div>
                <span class="step-label" style="color:${done ? '#111' : '#aaa'};">${s.charAt(0).toUpperCase()+s.slice(1)}</span>
              </div>`;
            }).join('')}
          </div>
          <div style="display:flex;gap:8px;padding:0 14px 14px;">
            <a href="/product/${p?.id}" style="flex:1;text-align:center;padding:9px;border-radius:8px;background:#f5f5f5;font-size:13px;font-weight:600;color:#333;">View Product</a>
            <a href="${waLink}" target="_blank" style="flex:1;text-align:center;padding:9px;border-radius:8px;background:#25D366;color:#fff;font-size:13px;font-weight:700;">💬 Contact Seller</a>
          </div>
        </div>`;
    }).join('');
  }

  function renderWishlist() {
    const items: any[] = JSON.parse(localStorage.getItem('kebay_wishlist') || '[]');
    const container = document.getElementById('wishlistItems')!;
    const empty = document.getElementById('wishlistEmpty')!;

    if (items.length === 0) { empty.style.display = 'block'; container.innerHTML = ''; return; }
    empty.style.display = 'none';

    container.innerHTML = items.map((item: any, i: number) => `
      <div class="wish-card">
        <img src="${item.image || 'https://picsum.photos/80'}" style="width:72px;height:72px;object-fit:cover;border-radius:10px;background:#f5f5f5;flex-shrink:0;" />
        <div style="flex:1;min-width:0;">
          <div style="font-weight:700;font-size:14px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${item.title}</div>
          <div style="font-size:15px;font-weight:800;color:#111;margin-top:3px;">${ksh(item.price)}</div>
        </div>
        <div style="display:flex;flex-direction:column;gap:6px;flex-shrink:0;">
          <a href="/product/${item.id}" style="padding:8px 14px;border-radius:8px;background:#25D366;color:#fff;font-size:13px;font-weight:700;text-align:center;">Buy</a>
          <button onclick="window._removeWish(${i})" style="padding:8px 14px;border-radius:8px;background:#fff5f5;color:#e53e3e;font-size:13px;font-weight:600;border:none;cursor:pointer;">Remove</button>
        </div>
      </div>`).join('');
  }

  (window as any)._removeWish = (i: number) => {
    const items: any[] = JSON.parse(localStorage.getItem('kebay_wishlist') || '[]');
    items.splice(i, 1);
    localStorage.setItem('kebay_wishlist', JSON.stringify(items));
    renderWishlist();
  };

  document.getElementById('filterStatus')?.addEventListener('change', renderOrders);

  async function loadDashboard() {
    const { data: { user } } = await supabase.auth.getUser();

    if (!user) {
      document.getElementById('welcomeName')!.textContent = 'Demo mode — sign in for your real data';
      document.getElementById('demoNotice')!.style.display = 'block';
      allOrders = demoOrders;
      renderOrders();
      renderWishlist();
      return;
    }

    const { data: profile } = await supabase.from('profiles').select('*').eq('id', user.id).single();
    document.getElementById('welcomeName')!.textContent = `Welcome, ${profile?.full_name || user.email} 👋`;

    if (profile) {
      (document.getElementById('pName') as HTMLInputElement).value = profile.full_name || '';
      (document.getElementById('pWa') as HTMLInputElement).value = profile.whatsapp_number || '';
    }

    const { data: orders } = await supabase
      .from('orders')
      .select('*, products(id, title, images, price, profiles(full_name, whatsapp_number))')
      .eq('buyer_id', user.id)
      .order('created_at', { ascending: false });

    allOrders = orders?.length ? orders : demoOrders;
    renderOrders();
    renderWishlist();
  }

  document.getElementById('saveProfileBtn')?.addEventListener('click', async () => {
    const { data: { user } } = await supabase.auth.getUser();
    if (!user) return;
    const name = (document.getElementById('pName') as HTMLInputElement).value.trim();
    const wa = (document.getElementById('pWa') as HTMLInputElement).value.trim().replace(/[\s-]/g,'');
    const location = (document.getElementById('pLocation') as HTMLInputElement).value.trim();
    await supabase.from('profiles').update({ full_name: name, whatsapp_number: wa }).eq('id', user.id);
    if (location) localStorage.setItem('kebay_location', location);
    document.getElementById('profileSaved')!.style.display = 'block';
    setTimeout(() => { document.getElementById('profileSaved')!.style.display = 'none'; }, 2000);
  });

  document.getElementById('changePasswordBtn')?.addEventListener('click', async () => {
    const pw = (document.getElementById('newPassword') as HTMLInputElement).value;
    const confirm = (document.getElementById('confirmPassword') as HTMLInputElement).value;
    const errEl = document.getElementById('pwError')!;
    errEl.style.display = 'none';
    if (pw.length < 6) { errEl.textContent = 'Password must be at least 6 characters.'; errEl.style.display = 'block'; return; }
    if (pw !== confirm) { errEl.textContent = 'Passwords do not match.'; errEl.style.display = 'block'; return; }
    const { error } = await supabase.auth.updateUser({ password: pw });
    if (error) { errEl.textContent = error.message; errEl.style.display = 'block'; return; }
    document.getElementById('pwSaved')!.style.display = 'block';
    (document.getElementById('newPassword') as HTMLInputElement).value = '';
    (document.getElementById('confirmPassword') as HTMLInputElement).value = '';
    setTimeout(() => { document.getElementById('pwSaved')!.style.display = 'none'; }, 2000);
  });

  document.getElementById('signOutBtn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  loadDashboard();

  // ── Realtime: subscribe to orders (buyer) ──
  let currentBuyerId: string | null = null;

  supabase.auth.getUser().then(({ data: { user } }) => {
    currentBuyerId = user?.id ?? null;
    if (!currentBuyerId) return;

    let realtimeTimer: ReturnType<typeof setTimeout> | null = null;

    async function handleOrderChange() {
      if (!currentBuyerId) return;
      // Capture snapshot before fetching fresh data
      const prevStatuses: Record<string, string> = {};
      allOrders.forEach((o: any) => { prevStatuses[o.id] = o.status; });

      const { data: orders } = await supabase
        .from('orders')
        .select('*, products(id, title, images, price, profiles(full_name, whatsapp_number))')
        .eq('buyer_id', currentBuyerId)
        .order('created_at', { ascending: false });

      allOrders = orders?.length ? orders : allOrders;
      renderOrders();

      // Detect status changes against the pre-fetch snapshot
      allOrders.forEach((o: any) => {
        if (prevStatuses[o.id] && prevStatuses[o.id] !== o.status) {
          (window as any).showToast?.(
            `📦 Your order status updated to ${o.status.charAt(0).toUpperCase() + o.status.slice(1)}!`,
            'info',
            3000
          );
        }
      });
    }

    const ordersChannel = supabase
      .channel('buyer-orders')
      .on('postgres_changes', { event: '*', schema: 'public', table: 'orders' }, () => {
        // Debounce: coalesce rapid successive events into one fetch
        if (realtimeTimer) clearTimeout(realtimeTimer);
        realtimeTimer = setTimeout(handleOrderChange, 200);
      })
      .subscribe();

    window.addEventListener('beforeunload', () => ordersChannel.unsubscribe());
  });
</script>
